{
  "name": "gulderen-lab",
  "type": "module",
  "version": "2.0.0",
  "private": true,
  "description": "Gulderen Lab — elektronik, gömülü sistemler ve CAD üzerine Türkçe teknik blog ve proje sitesi",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev --host",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "astro": "astro",
    "clean": "node -e \"for (const d of ['dist','.astro','node_modules/.astro']) require('fs').rmSync(d,{recursive:true,force:true})\"",
    "analyze": "node scripts/performance-analysis.js",
    "build:analyze": "npm run build && npm run analyze",
    "optimize:images": "node scripts/optimize-images.mjs",
    "new:post": "node scripts/new-post.mjs",
    "verify": "astro check && astro build",
    "check:links": "node scripts/check-links.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.4",
    "@astrojs/mdx": "^8.1.1",
    "@astrojs/react": "^7.1.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@google/model-viewer": "^4.4.0",
    "astro": "^7.4.2",
    "astro-pagefind": "^2.0.1",
    "katex": "^0.19.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "katex": "$katex",
    "@tailwindcss/typography": {
      "postcss-selector-parser": "^6.1.5"
    }
  }
}
