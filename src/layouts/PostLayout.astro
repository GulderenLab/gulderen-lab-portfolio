---
// src/layouts/PostLayout.astro — Blog yazıları ve projeler için ortak sayfa şablonu
import type { MarkdownHeading } from 'astro';
import Layout from './Layout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import ShareLinks from '../components/ShareLinks.astro';
import { SITE } from '../lib/site';
import 'katex/dist/katex.min.css';
import {
  type AnyEntry,
  type ContentKind,
  entryUrl,
  formatDate,
  getRelated,
  getSeriesNav,
  readingTime,
  tagSlug,
} from '../lib/content';

interface Props {
  kind: ContentKind;
  entry: AnyEntry;
  all: AnyEntry[];
  headings: MarkdownHeading[];
}

const { kind, entry, all, headings } = Astro.props;
const data = entry.data as AnyEntry['data'] & Record<string, any>;

const labels =
  kind === 'blog'
    ? { section: 'Blog', back: '← Tüm Yazılara Geri Dön', prev: 'Önceki Bölüm', next: 'Sonraki Bölüm', related: 'İlgili Yazılar', schema: 'BlogPosting' }
    : { section: 'Projeler', back: '← Tüm Projelere Geri Dön', prev: 'Önceki Proje', next: 'Sonraki Proje', related: 'İlgili Projeler', schema: 'Article' };

const url = new URL(entryUrl(kind, entry), Astro.site ?? SITE.url).toString();
const minutes = readingTime(entry.body);
const { prev, next } = getSeriesNav(entry, all);
const related = getRelated(entry, all);
const author = data.author ?? SITE.author.name;
const tags: string[] = data.tags ?? [];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': labels.schema,
    headline: data.title,
    description: data.description,
    inLanguage: 'tr-TR',
    datePublished: data.publishDate.toISOString(),
    dateModified: (data.updatedDate ?? data.publishDate).toISOString(),
    author: { '@type': 'Person', name: author, url: new URL('/hakkimizda/', SITE.url).toString() },
    publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
    mainEntityOfPage: { '@type': 'WebPage', '@id': url },
    ...(data.image?.src ? { image: new URL(data.image.src, SITE.url).toString() } : {}),
    keywords: tags.join(', '),
    timeRequired: `PT${minutes}M`,
    ...(data.seriesSlug ? { isPartOf: { '@type': 'CreativeWorkSeries', name: data.seriesSlug } } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Ana Sayfa', item: SITE.url + '/' },
      { '@type': 'ListItem', position: 2, name: labels.section, item: `${SITE.url}/${kind}/` },
      { '@type': 'ListItem', position: 3, name: data.title, item: url },
    ],
  },
];
---

<Layout
  title={data.title}
  description={data.description}
  image={data.image?.src}
  imageAlt={data.image?.alt}
  type="article"
  publishedTime={data.publishDate}
  modifiedTime={data.updatedDate}
  tags={tags}
  jsonLd={jsonLd}
>
  <div class="max-w-3xl mx-auto py-8 px-4 not-prose">
    {/* Breadcrumb */}
    <nav aria-label="Konum" class="text-sm text-gray-400 mb-6">
      <ol class="flex flex-wrap items-center gap-1">
        <li><a href="/" class="hover:text-cyan-300">Ana Sayfa</a></li>
        <li aria-hidden="true">/</li>
        <li><a href={`/${kind}/`} class="hover:text-cyan-300">{labels.section}</a></li>
        <li aria-hidden="true">/</li>
        <li class="text-gray-300 truncate max-w-[16rem]" aria-current="page">{data.title}</li>
      </ol>
    </nav>

    {data.image && (
      <img
        src={data.image.src}
        alt={data.image.alt}
        width="1200"
        height="630"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="w-full rounded-lg shadow-md mb-8 max-h-96 object-cover"
      />
    )}

    <header class="mb-6 border-b border-gray-700 pb-4">
      <h1 class="text-4xl md:text-5xl font-bold mb-4 text-accent-light leading-tight">
        {data.title}
        {data.part && data.totalPages && (
          <span class="block text-2xl text-gray-400 mt-1">Bölüm {data.part} / {data.totalPages}</span>
        )}
      </h1>

      <div class="flex flex-wrap gap-x-4 gap-y-1 text-sm text-gray-400">
        <span>
          Yayınlanma: <time datetime={data.publishDate.toISOString()}>{formatDate(data.publishDate)}</time>
        </span>
        {data.updatedDate && (
          <span>
            Güncellendi: <time datetime={data.updatedDate.toISOString()}>{formatDate(data.updatedDate)}</time>
          </span>
        )}
        <span>{minutes} dk okuma</span>
        <span>Yazar: {author}</span>
      </div>

      {tags.length > 0 && (
        <ul class="mt-3 flex flex-wrap gap-2" aria-label="Etiketler">
          {tags.map((tag) => (
            <li>
              <a
                href={`/etiket/${tagSlug(tag)}/`}
                class="inline-block bg-gray-700/70 hover:bg-cyan-800/60 text-gray-300 hover:text-white text-xs font-medium px-2.5 py-0.5 rounded-full transition-colors"
              >
                #{tag}
              </a>
            </li>
          ))}
        </ul>
      )}
    </header>

    {headings.length > 1 && <TableOfContents headings={headings} />}

    <div
      class="prose prose-lg prose-invert
             prose-headings:text-accent-light prose-headings:scroll-mt-24 prose-a:text-brand hover:prose-a:text-accent-light
             prose-code:text-accent-light prose-pre:bg-gray-800
             max-w-none mt-8"
      data-pagefind-body
    >
      <slot />
    </div>

    {(prev || next) && (
      <nav class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-12 border-t border-gray-700 pt-6" aria-label="Seri gezinmesi">
        <div>
          {prev && (
            <a href={entryUrl(kind, prev)} class="group block rounded-lg border border-slate-700 p-4 hover:border-cyan-400/60 transition-colors">
              <span class="block text-xs text-gray-400">← {labels.prev}</span>
              <span class="block font-semibold text-accent-light group-hover:underline">{prev.data.title}</span>
            </a>
          )}
        </div>
        <div class="sm:text-right">
          {next && (
            <a href={entryUrl(kind, next)} class="group block rounded-lg border border-slate-700 p-4 hover:border-cyan-400/60 transition-colors">
              <span class="block text-xs text-gray-400">{labels.next} →</span>
              <span class="block font-semibold text-accent-light group-hover:underline">{next.data.title}</span>
            </a>
          )}
        </div>
      </nav>
    )}

    <ShareLinks url={url} title={data.title} />

    {related.length > 0 && (
      <section class="mt-12" aria-labelledby="related-heading">
        <h2 id="related-heading" class="text-2xl font-bold text-white mb-4">{labels.related}</h2>
        <ul class="grid gap-4 sm:grid-cols-3">
          {related.map((r) => (
            <li>
              <a href={entryUrl(kind, r)} class="block h-full rounded-lg border border-slate-700 bg-slate-800/40 p-4 hover:border-cyan-400/60 transition-colors">
                <span class="block font-semibold text-gray-100 mb-1">{r.data.title}</span>
                <span class="block text-xs text-gray-400">{formatDate(r.data.publishDate)}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <a href={`/${kind}/`} class="inline-block mt-10 text-accent-light hover:underline font-semibold">
      {labels.back}
    </a>
  </div>
</Layout>
