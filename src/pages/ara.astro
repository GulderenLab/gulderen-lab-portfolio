---
// src/pages/ara.astro — Pagefind ile tam metin arama (sunucu gerektirmez)
import Layout from '../layouts/Layout.astro';
import PagefindConfig from 'astro-pagefind/components/PagefindConfig.astro';
---

<Layout title="Ara" description="Gulderen Lab'daki tüm yazı ve projelerde tam metin arama.">
  <section class="not-prose max-w-3xl mx-auto px-4 py-12 search-page">
    <h1 class="text-4xl font-bold text-white mb-2">Sitede Ara</h1>
    <p class="text-gray-400 mb-8">Yazıların ve projelerin tam metninde arama yapar. Örn: <em>I2C pull-up</em>, <em>LT3045</em>, <em>fillet</em>.</p>
    <PagefindConfig />
    <pagefind-input placeholder="Aramak istediğiniz kelimeyi yazın…" autofocus></pagefind-input>
    <pagefind-summary class="block my-4 text-sm text-gray-400"></pagefind-summary>
    <pagefind-results></pagefind-results>
  </section>
</Layout>

<script>
  // ?q=… parametresini arama kutusuna aktar (WebSite SearchAction ile uyumlu)
  function prefill() {
    const q = new URLSearchParams(location.search).get('q');
    if (!q) return;
    let tries = 0;
    const t = setInterval(() => {
      const input = document.querySelector<HTMLInputElement>('pagefind-input input');
      if (input || ++tries > 40) {
        clearInterval(t);
        if (input) {
          input.value = q;
          input.dispatchEvent(new Event('input', { bubbles: true }));
        }
      }
    }, 100);
  }
  prefill();
  document.addEventListener('astro:page-load', () => location.pathname.startsWith('/ara') && prefill());
</script>

<style is:global>
  .search-page {
    --pf-background: transparent;
    --pf-text: #f1f5f9;
    --pf-text-secondary: #cbd5e1;
    --pf-text-muted: #94a3b8;
    --pf-border: #334155;
    --pf-border-focus: #22d3ee;
    --pf-hover: rgba(51, 65, 85, 0.5);
    --pf-mark: rgba(34, 211, 238, 0.35);
    --pf-skeleton: #1e293b;
  }
</style>
