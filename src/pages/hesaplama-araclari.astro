        // AWG Calculator Functions
        window.calculateAWG = function() {
            var typeEl = document.getElementById('awg-input-type');
            var valueEl = document.getElementById('awg-input-value');
            var resultsDiv = document.getElementById('awg-results');
            var basicResults = document.getElementById('awg-basic-results');
            var currentResults = document.getElementById('awg-current-results');
            if (!typeEl || !valueEl || !resultsDiv || !basicResults || !currentResults) return;
            var inputType = typeEl.value;
            var inputValue = parseFloat(valueEl.value);

            if (isNaN(inputValue) || inputValue <= 0) {
                alert('Lütfen geçerli bir pozitif değer girin!');
                return;
            }

            // AWG to diameter (mil) conversion formula: diameter_mil = 92^((36-AWG)/39) * 5
            // Standard AWG current ratings (approximate values for 30°C ambient, 60°C conductor temp)
            var awgCurrentRatings = {
                40: 0.09, 38: 0.13, 36: 0.19, 34: 0.27, 32: 0.36, 30: 0.52,
                28: 0.74, 26: 1.0, 24: 1.4, 22: 2.1, 20: 2.9, 18: 4.0,
                16: 5.5, 14: 8.0, 12: 11, 10: 15, 8: 24, 6: 37, 4: 55,
                2: 75, 1: 85, 0: 100, '00': 115, '000': 130, '0000': 150
            };

            var awg, diameterMil, diameterMm, areaMm2, areaKcmil, currentRating;

            // Convert input to AWG equivalent diameter in mils
            switch(inputType) {
                case 'awg':
                    awg = Math.round(inputValue);
                    if (awg < -3 || awg > 40) {
                        alert('AWG değeri -3 ile 40 arasında olmalıdır!');
                        return;
                    }
                    diameterMil = Math.pow(92, (36 - awg) / 39) * 5;
                    break;
                
                case 'diameter-mm':
                    diameterMm = inputValue;
                    diameterMil = diameterMm / 0.0254;
                    awg = Math.round(36 - 39 * Math.log(diameterMil / 5) / Math.log(92));
                    break;
                
                case 'diameter-mil':
                    diameterMil = inputValue;
                    awg = Math.round(36 - 39 * Math.log(diameterMil / 5) / Math.log(92));
                    break;
                
                case 'area-mm2':
                    areaMm2 = inputValue;
                    diameterMm = Math.sqrt(areaMm2 * 4 / Math.PI);
                    diameterMil = diameterMm / 0.0254;
                    awg = Math.round(36 - 39 * Math.log(diameterMil / 5) / Math.log(92));
                    break;
                
                case 'area-kcmil':
                    areaKcmil = inputValue;
                    areaMm2 = areaKcmil * 0.5067;
                    diameterMm = Math.sqrt(areaMm2 * 4 / Math.PI);
                    diameterMil = diameterMm / 0.0254;
                    awg = Math.round(36 - 39 * Math.log(diameterMil / 5) / Math.log(92));
                    break;
            }

            // Calculate all other values
            if (!diameterMm) diameterMm = diameterMil * 0.0254;
            if (!areaMm2) areaMm2 = Math.PI * Math.pow(diameterMm / 2, 2);
            if (!areaKcmil) areaKcmil = areaMm2 / 0.5067;
            
            // Get current rating
            var awgKey = awg;
            if (awg <= 0) {
                if (awg === 0) awgKey = 0;
                else if (awg === -1) awgKey = '00';
                else if (awg === -2) awgKey = '000';
                else if (awg === -3) awgKey = '0000';
            }
            
            currentRating = awgCurrentRatings[awgKey] || 'N/A';

            // Format AWG display
            var awgDisplay;
            if (awg === 0) awgDisplay = '1/0 (0)';
            else if (awg === -1) awgDisplay = '2/0 (00)';
            else if (awg === -2) awgDisplay = '3/0 (000)';
            else if (awg === -3) awgDisplay = '4/0 (0000)';
            else awgDisplay = awg.toString();

            // Update basic results
            basicResults.innerHTML = `
                <p><strong>AWG:</strong> ${awgDisplay}</p>
                <p><strong>Çap:</strong> ${diameterMm.toFixed(3)} mm (${diameterMil.toFixed(1)} mil)</p>
                <p><strong>Kesit Alanı:</strong> ${areaMm2.toFixed(3)} mm²</p>
                <p><strong>Kesit Alanı:</strong> ${areaKcmil.toFixed(1)} kcmil</p>
            `;

            // Update current results
            if (typeof currentRating === 'number') {
                currentResults.innerHTML = `
                    <p><strong>Sürekli Akım:</strong> ${currentRating} A</p>
                    <p><strong>Koşullar:</strong> 30°C ortam</p>
                    <p><strong>İletken Sıcaklık:</strong> 60°C</p>
                    <p class="text-yellow-300 text-xs mt-2">Not: Değerler yaklaşık değerlerdir. Gerçek uygulamada yerel standartları kontrol edin.</p>
                `;
            } else {
                currentResults.innerHTML = `
                    <p><strong>Sürekli Akım:</strong> Veri yok</p>
                    <p class="text-gray-400 text-xs">Bu AWG değeri için standart akım verisi bulunmamaktadır.</p>
                `;
            }

            resultsDiv.classList.remove('hidden');
        };

