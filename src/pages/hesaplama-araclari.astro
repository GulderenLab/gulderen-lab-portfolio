        // Additional helper functions for perfect Ohm's Law Calculator
        window.validateOhmInput = function(input) {
            const value = parseFloat(input.value);
            const statusIndicator = input.parentElement?.querySelector('.input-status');
            
            if (statusIndicator) {
                if (isNaN(value) || value <= 0) {
                    statusIndicator.classList.remove('peer-valid:bg-green-400');
                    statusIndicator.classList.add('peer-invalid:bg-red-400');
                } else {
                    statusIndicator.classList.remove('peer-invalid:bg-red-400');
                    statusIndicator.classList.add('peer-valid:bg-green-400');
                }
            }
        };

        window.autoCalculateOhm = function() {
            // Auto-calculate when user changes input
            setTimeout(function() {
                const voltage = parseFloat(document.getElementById('voltage')?.value || '');
                const current = parseFloat(document.getElementById('current')?.value || '');
                const resistance = parseFloat(document.getElementById('resistance')?.value || '');
                
                let validInputs = 0;
                if (!isNaN(voltage) && voltage > 0) validInputs++;
                if (!isNaN(current) && current > 0) validInputs++;
                if (!isNaN(resistance) && resistance > 0) validInputs++;
                
                if (validInputs >= 2) {
                    calculateOhmEnhanced();
                } else {
                    const result = document.getElementById('ohm-result-enhanced');
                    if (result) {
                        result.style.display = 'none';
                    }
                }
            }, 300); // Small delay to avoid too frequent calculations
        };

        window.clearOhmInputs = function() {
            const inputs = ['voltage', 'current', 'resistance'];
            inputs.forEach(function(id) {
                const input = document.getElementById(id);
                if (input) {
                    input.value = '';
                    validateOhmInput(input);
                }
            });
            
            const result = document.getElementById('ohm-result-enhanced');
            if (result) {
                result.style.display = 'none';
            }
        };

        window.highlightFormula = function(type) {
            const inputs = {
                'voltage': ['current', 'resistance'],
                'current': ['voltage', 'resistance'],
                'resistance': ['voltage', 'current']
            };
            
            if (inputs[type]) {
                inputs[type].forEach(function(inputId) {
                    const input = document.getElementById(inputId);
                    if (input) {
                        input.focus();
                        input.style.transform = 'scale(1.02)';
                        input.style.borderColor = '#a855f7';
                        input.style.boxShadow = '0 0 0 3px rgba(168, 85, 247, 0.1)';
                        
                        setTimeout(function() {
                            input.style.transform = '';
                            input.style.borderColor = '';
                            input.style.boxShadow = '';
                        }, 2000);
                    }
                });
            }
        };

    });
</script>
