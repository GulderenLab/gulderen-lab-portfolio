---
// src/pages/hesaplama-araclari.astro
import Layout from '../layouts/Layout.astro';

const pageTitle = "Hesaplama Araçları";
const pageDescription = "Elektronik, mühendislik ve yazılım geliştirme için pratik hesaplama araçları. Ohm Kanunu, güç hesaplamaları, frekans dönüştürücüleri ve daha fazlası.";

// Calculator categories
const calculatorCategories = [
    {
        title: "Elektronik Hesaplamaları",
        icon: "cpu-chip",
        description: "Temel elektronik devre hesaplamaları",
        calculators: [
            { name: "Ohm Kanunu", id: "ohm", description: "Voltaj, akım ve direnç hesaplamaları" },
            { name: "Güç Hesaplama", id: "power", description: "Elektrik güç hesaplamaları" },
            { name: "RC Zaman Sabiti", id: "rc-time", description: "RC devre zaman sabiti hesaplama" },
            { name: "LED Direnç", id: "led-resistor", description: "LED için gerekli direnç hesaplama" },
            { name: "LT3045/LT3094 VPGF", id: "lt3045-vpgf", description: "Linear Technology regülatör gerilim bölücü hesaplama" },
            { name: "AWG Dönüşüm Hesaplayıcı", id: "awg", description: "AWG ölçü birimleri arasındaki dönüşüm hesaplamaları" },
            { name: "Direnç Seri/Paralel", id: "resistor-combine", description: "Seri ve paralel eşdeğer direnç" },
            { name: "Reaktif Empedans", id: "reactive", description: "Xc ve Xl hesaplama" }
        ]
    },
    {
        title: "Frekans & Sinyal",
        icon: "wave",
        description: "Sinyal işleme ve frekans hesaplamaları",
        calculators: [
            { name: "Frekans Dönüştürücü", id: "frequency", description: "Hz, kHz, MHz arası dönüşüm" },
            { name: "Periyot Hesaplama", id: "period", description: "Frekans-periyot dönüşümü" },
            { name: "dB Hesaplama", id: "decibel", description: "Desibel dönüşümleri" },
            { name: "Dalga Boyu", id: "wavelength", description: "Frekans-dalga boyu hesaplama" },
            { name: "PWM Zaman Çözünürlüğü", id: "pwm", description: "Frekans, duty ve timer çözünürlüğü" },
            { name: "RF Friis Bağlantı", id: "rf-friis", description: "Serbest uzay bağlantı bütçesi" }
        ]
    },
    {
        title: "Veri & Programlama",
        icon: "code",
        description: "Yazılım geliştirme hesaplamaları",
        calculators: [
            { name: "Sayı Sistemi", id: "number-base", description: "Binary, decimal, hex dönüşüm" },
            { name: "Veri Boyutu", id: "data-size", description: "Byte, KB, MB, GB dönüşümleri" },
            { name: "CRC Hesaplama", id: "crc", description: "Cyclic Redundancy Check" },
            { name: "Hash Hesaplama", id: "hash", description: "MD5, SHA hash hesaplama" }
        ]
    },
    {
        title: "IoT & Sensörler",
        icon: "sensor",
        description: "IoT projeleri için hesaplamaları",
        calculators: [
            { name: "ADC Çözünürlük", id: "adc", description: "Analog-dijital dönüştürücü hesaplamaları" },
            { name: "Pil Ömrü", id: "battery", description: "IoT cihaz pil ömrü tahmini (gelişmiş model)" },
            { name: "WiFi Mesafe", id: "wifi-range", description: "WiFi serbest uzay + hassasiyet + marj" },
            { name: "Sıcaklık Dönüşüm", id: "temperature", description: "Celsius, Fahrenheit, Kelvin" },
            { name: "Voltaj Bölücü ve Yük", id: "divider-load", description: "Yük etkisiyle bölücü" },
            { name: "I2C Pull-up Direnci", id: "i2c-pullup", description: "Cbus ve yükselme zamanına göre Rp önerisi" },
            { name: "UART Baud Hatası", id: "uart-baud", description: "Saatten baud hata yüzdesi" }
        ]
    }
];
// UI Enhancements: search, filters, counts derived from data
const allCalculatorsFlat = calculatorCategories.flatMap(c => c.calculators.map(calc => ({ ...calc, category: c.title })));
---

<Layout title={pageTitle} description={pageDescription}>
    
    {/* HERO SECTION */}
    <section class="relative min-h-[60vh] flex items-center justify-center overflow-hidden mb-8">
        {/* Animated Background */}
        <div class="absolute inset-0 bg-gradient-to-br from-slate-900 via-purple-900/20 to-blue-900/20"></div>
        <div class="absolute inset-0">
            <div class="absolute top-20 left-20 w-72 h-72 bg-purple-500/10 rounded-full blur-3xl animate-pulse"></div>
            <div class="absolute bottom-20 right-20 w-96 h-96 bg-blue-500/10 rounded-full blur-3xl animate-pulse delay-1000"></div>
            <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-gradient-to-r from-purple-500/5 to-blue-500/5 rounded-full blur-3xl"></div>
        </div>
        
        <div class="relative z-10 container mx-auto px-6 text-center">
            {/* Professional Badge */}
            <div class="inline-flex items-center px-4 py-2 mb-8 bg-slate-800/50 backdrop-blur-sm border border-slate-700/50 rounded-full">
                <svg class="w-5 h-5 mr-3 text-purple-400" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M19.5 3.2l-1.6-1.6c-.4-.4-1-.4-1.4 0L4.8 13.3c-.2.2-.3.4-.3.7v3c0 .6.4 1 1 1h3c.3 0 .5-.1.7-.3L21 5.9c.4-.4.4-1 0-1.4zM5.5 16v-1.5L15.3 4.7l1.5 1.5L6.9 16H5.5zm11.3-11.3L15.3 3.2l1.4-1.4 1.5 1.5-1.4 1.4z"/>
                </svg>
                <span class="text-sm text-purple-400 font-medium">Mühendislik Araçları</span>
            </div>
            
            {/* Main Heading */}
            <h1 class="text-4xl md:text-6xl lg:text-7xl font-bold mb-8 leading-tight">
                <span class="block text-white mb-4">Hesaplama</span>
                <span class="block bg-gradient-to-r from-purple-400 via-blue-300 to-cyan-400 bg-clip-text text-transparent">
                    Araçları
                </span>
            </h1>
            
            {/* Subtitle */}
            <p class="text-xl md:text-2xl text-gray-300 max-w-4xl mx-auto mb-12 leading-relaxed">
                Elektronik, mühendislik ve yazılım geliştirme projeleriniz için 
                <span class="text-purple-300 font-semibold">pratik hesaplama araçları</span> ve dönüştürücüler.
            </p>
            
            {/* Quick Stats + Search */}
            <div class="flex flex-col items-center gap-6">
                <div class="flex flex-wrap justify-center gap-8 text-center">
                    <div class="bg-slate-800/30 backdrop-blur-sm border border-slate-700/50 rounded-xl px-6 py-4">
                        <div class="text-2xl font-bold text-purple-400">{allCalculatorsFlat.length}</div>
                        <div class="text-sm text-gray-400">Hesaplama Aracı</div>
                    </div>
                    <div class="bg-slate-800/30 backdrop-blur-sm border border-slate-700/50 rounded-xl px-6 py-4">
                        <div class="text-2xl font-bold text-blue-400">{calculatorCategories.length}</div>
                        <div class="text-sm text-gray-400">Kategori</div>
                    </div>
                    <div class="bg-slate-800/30 backdrop-blur-sm border border-slate-700/50 rounded-xl px-6 py-4">
                        <div class="text-2xl font-bold text-cyan-400">∞</div>
                        <div class="text-sm text-gray-400">Kullanım</div>
                    </div>
                </div>

                <div class="w-full max-w-3xl">
                    <label for="calc-search" class="sr-only">Ara</label>
                    <div class="relative">
                        <svg class="w-5 h-5 text-gray-400 absolute left-3 top-1/2 -translate-y-1/2" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                            <circle cx="11" cy="11" r="7" stroke-width="2"></circle>
                            <path d="M21 21l-4.3-4.3" stroke-width="2" stroke-linecap="round"></path>
                        </svg>
                        <input id="calc-search" type="text" placeholder="Araç adı veya kategori ara (örn: Ohm, AWG, Elektronik)..."
                               class="w-full pl-10 pr-12 py-3 bg-slate-800/60 border border-slate-700/60 rounded-xl text-white placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent" />
                        <button id="clear-search" class="absolute right-2 top-1/2 -translate-y-1/2 px-3 py-1 text-sm text-gray-300 hover:text-white bg-slate-700/60 rounded-lg hidden">Temizle</button>
                    </div>
                    <div id="active-filters" class="mt-3 flex flex-wrap gap-2"></div>
                    <div class="mt-4 flex flex-wrap items-center justify-center gap-3">
                        <button id="toggle-view-cards" class="px-3 py-1.5 rounded-lg text-sm bg-slate-800/60 border border-slate-700/60 text-gray-200 hover:bg-slate-700/60 transition">Kart Görünümü</button>
                        <button id="toggle-view-list" class="px-3 py-1.5 rounded-lg text-sm bg-slate-800/40 border border-slate-700/60 text-gray-300 hover:bg-slate-700/60 transition">Liste Görünümü</button>
                        <span class="text-xs text-gray-400">•</span>
                        <button id="expand-all" class="px-3 py-1.5 rounded-lg text-sm bg-slate-800/40 border border-slate-700/60 text-gray-300 hover:bg-slate-700/60 transition">Tüm Kategorileri Aç</button>
                        <button id="collapse-all" class="px-3 py-1.5 rounded-lg text-sm bg-slate-800/40 border border-slate-700/60 text-gray-300 hover:bg-slate-700/60 transition">Tümünü Kapat</button>
                    </div>
                </div>
            </div>
        </div>
    </section>

    {/* CALCULATOR CATEGORIES */}
    <section class="py-16">
        <div class="container mx-auto px-6">
            
            {/* Section Header */}
            <div class="text-center mb-16">
                <div class="inline-flex items-center px-4 py-2 mb-6 bg-slate-800/50 backdrop-blur-sm border border-slate-700/50 rounded-full">
                    <span class="text-sm text-blue-400 font-medium">Hesaplama Kategorileri</span>
                </div>
                <h2 class="text-3xl md:text-4xl font-bold mb-6">
                    <span class="bg-gradient-to-r from-white to-gray-300 bg-clip-text text-transparent">
                        Mühendislik Araçları
                    </span>
                </h2>
                <p class="text-xl text-gray-400 max-w-2xl mx-auto">
                    Projelerinizde ihtiyaç duyacağınız tüm hesaplama araçları
                </p>
            </div>

            {/* Categories Grid with filterable items + collapse + list view */}
            <div id="categories-grid" class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-16">
                {calculatorCategories.map((category, categoryIndex) => (
                    <div class="group relative category-card" data-category={category.title}>
                        <div class="bg-gradient-to-br from-slate-800/40 to-slate-900/60 backdrop-blur-xl border border-slate-700/30 rounded-3xl p-6 md:p-8 hover:border-purple-400/40 transition-all duration-700 hover:transform hover:scale-[1.01] hover:shadow-2xl hover:shadow-purple-500/20">
                            <button class="w-full text-left flex items-center justify-between gap-4 mb-4 md:mb-6 toggle-category" aria-expanded="true">
                                <div class="flex items-center">
                                    <div class="w-12 h-12 md:w-16 md:h-16 bg-gradient-to-br from-purple-400/20 to-blue-500/20 backdrop-blur-sm border border-purple-400/30 rounded-2xl flex items-center justify-center mr-3 md:mr-4 group-hover:from-purple-400/30 group-hover:to-blue-500/30 group-hover:border-purple-400/50 transition-all duration-500">
                                        <svg class="w-7 h-7 md:w-8 md:h-8 text-purple-400 group-hover:text-purple-300 transition-colors" fill="currentColor" viewBox="0 0 24 24">
                                            {categoryIndex === 0 && <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>}
                                            {categoryIndex === 1 && <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.94-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/>}
                                            {categoryIndex === 2 && <path d="M9.5 16a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3M6.5 12a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3M12 3a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3"/>}
                                            {categoryIndex === 3 && <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>}
                                        </svg>
                                    </div>
                                    <div class="flex-1">
                                        <h3 class="text-lg md:text-xl font-bold text-white group-hover:text-purple-300 transition-colors duration-300">{category.title}</h3>
                                        <p class="text-gray-400 text-sm">{category.description}</p>
                                    </div>
                                </div>
                                <div class="flex items-center gap-2 shrink-0">
                                    <span class="text-xs text-gray-400 bg-slate-800/60 border border-slate-700/60 rounded-full px-3 py-1 category-count">{category.calculators.length} araç</span>
                                    <svg class="w-5 h-5 text-gray-400 chevron transition-transform duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                        <path d="M6 9l6 6 6-6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                                    </svg>
                                </div>
                            </button>

                            <div class="space-y-3 category-items">
                                {category.calculators.map((calc) => (
                                    <div class="calculator-item bg-slate-700/30 hover:bg-slate-700/50 border border-slate-600/30 hover:border-purple-400/50 rounded-xl p-4 transition-all duration-300 cursor-pointer"
                                         data-calculator={calc.id} data-name={calc.name.toLowerCase()} data-category={category.title.toLowerCase()}>
                                        <div class="flex items-center justify-between gap-3">
                                            <div class="min-w-0">
                                                <h4 class="font-semibold text-white mb-1 truncate">{calc.name}</h4>
                                                <p class="text-sm text-gray-400 line-clamp-1">{calc.description}</p>
                                            </div>
                                            <div class="flex items-center gap-2 shrink-0">
                                                <span class="hidden md:inline-block text-xs text-blue-300 bg-blue-900/30 border border-blue-500/30 rounded-full px-2 py-0.5">{category.title}</span>
                                                <svg class="w-5 h-5 text-purple-400 opacity-0 group-hover:opacity-100 transform translate-x-2 group-hover:translate-x-0 transition-all duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                                                </svg>
                                            </div>
                                        </div>
                                    </div>
                                ))}
                            </div>

                            <div class="absolute inset-0 bg-gradient-to-br from-purple-500/0 via-blue-500/0 to-cyan-500/0 group-hover:from-purple-500/5 group-hover:via-blue-500/5 group-hover:to-cyan-500/5 rounded-3xl transition-all duration-700 pointer-events-none"></div>
                            <div class="absolute -inset-1 bg-gradient-to-br from-purple-500/0 to-blue-500/0 group-hover:from-purple-500/20 group-hover:to-blue-500/20 rounded-3xl blur-xl transition-all duration-700 -z-10 opacity-0 group-hover:opacity-100"></div>
                        </div>
                    </div>
                ))}
            </div>
        </div>
    </section>

    {/* CALCULATOR MODAL */}
    {/* CALCULATOR MODAL (sticky header, better spacing) */}
    <div id="calculator-modal" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 hidden items-center justify-center p-4">
      <div class="bg-slate-900/95 border border-slate-700/70 rounded-2xl max-w-2xl w-full max-h-[90vh] overflow-y-auto shadow-2xl">
        <div class="sticky top-0 z-10 bg-slate-900/95 border-b border-slate-700/60 px-6 py-4 flex items-center justify-between">
          <h3 id="modal-title" class="text-lg md:text-xl font-bold text-white">Hesaplama Aracı</h3>
          <button id="close-modal" class="p-2 hover:bg-slate-800 rounded-lg transition-colors" aria-label="Kapat">
            <svg class="w-6 h-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
        <div id="calculator-content" class="p-6 space-y-6">
          <!-- İçerik JS ile yüklenecek -->
        </div>
      </div>
    </div>

</Layout>

{/* Enhanced CSS for Perfect Calculator Design */}
<style is:global>
    /* Enhanced Calculator Styles */
    .calculator-container {
        opacity: 0;
        animation: fadeIn 0.6s ease-out forwards;
    }

    .calculator-header {
        position: relative;
        z-index: 10;
    }

    .calculator-title {
        background: linear-gradient(135deg, #ffffff, #e2e8f0);
        background-clip: text;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        color: transparent;
    }

    .calculator-description {
        max-width: 600px;
        margin: 0 auto;
        line-height: 1.6;
    }

    .calculator-input-group {
        position: relative;
    }

    .calculator-label {
        display: flex;
        align-items: center;
        font-size: 0.875rem;
        font-weight: 600;
        color: #e2e8f0;
        margin-bottom: 0.75rem;
        transition: color 0.3s ease;
    }

    .calculator-label:hover {
        color: #a855f7;
    }

    .calculator-input {
        width: 100%;
        padding: 0.875rem 3rem 0.875rem 0.875rem;
        background: rgba(51, 65, 85, 0.6);
        border: 1px solid rgba(71, 85, 105, 0.5);
        border-radius: 0.75rem;
        color: white;
        font-size: 1rem;
        transition: all 0.3s ease;
        backdrop-filter: blur(10px);
        outline: none;
    }

    .calculator-input:focus {
        border-color: #a855f7;
        box-shadow: 0 0 0 3px rgba(168, 85, 247, 0.1);
        background: rgba(51, 65, 85, 0.8);
        transform: translateY(-1px);
    }

    .calculator-input:valid {
        border-color: #10b981;
    }

    .calculator-input:invalid:not(:placeholder-shown) {
        border-color: #ef4444;
    }

    .calculator-input::placeholder {
        color: #9ca3af;
        opacity: 0.7;
    }

    .calculator-button-container {
        display: flex;
        justify-content: center;
        position: relative;
    }

    .calculator-button {
        background: linear-gradient(135deg, #a855f7, #3b82f6);
        color: white;
        border: none;
        border-radius: 0.75rem;
        font-weight: 600;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(168, 85, 247, 0.2);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
    }

    .calculator-button::before {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
        transition: left 0.6s;
    }

    .calculator-button:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(168, 85, 247, 0.3);
        background: linear-gradient(135deg, #9333ea, #2563eb);
    }

    .calculator-button:hover::before {
        left: 100%;
    }

    .calculator-button:active {
        transform: translateY(0);
        box-shadow: 0 2px 10px rgba(168, 85, 247, 0.4);
    }

    .calculator-loading {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .calculator-loading-spinner {
        width: 1rem;
        height: 1rem;
        border: 2px solid rgba(255, 255, 255, 0.3);
        border-top: 2px solid white;
        border-radius: 50%;
        animation: spin 1s linear infinite;
    }

    .calculator-result {
        background: linear-gradient(135deg, rgba(51, 65, 85, 0.6), rgba(71, 85, 105, 0.6));
        backdrop-filter: blur(16px);
        border: 1px solid rgba(71, 85, 105, 0.5);
        border-radius: 1.5rem;
        padding: 2rem;
        margin-bottom: 1.5rem;
        position: relative;
        overflow: hidden;
    }

    .calculator-result::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 1px;
        background: linear-gradient(90deg, transparent, rgba(168, 85, 247, 0.5), transparent);
    }

    .calculator-result-title {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        font-size: 1.125rem;
        font-weight: 700;
        color: #e2e8f0;
        margin-bottom: 1rem;
    }

    .calculator-result-title svg {
        width: 1.25rem;
        height: 1.25rem;
        flex-shrink: 0;
    }

    .calculator-result-value {
        color: #10b981;
        text-shadow: 0 2px 10px rgba(16, 185, 129, 0.3);
    }

    .calculator-result-description {
        color: #9ca3af;
        font-size: 0.875rem;
        line-height: 1.5;
    }

    .calculator-badge {
        display: inline-flex;
        align-items: center;
        padding: 0.25rem 0.75rem;
        border-radius: 9999px;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.025em;
    }

    .calculator-badge-primary {
        background: linear-gradient(135deg, rgba(168, 85, 247, 0.2), rgba(59, 130, 246, 0.2));
        color: #a855f7;
        border: 1px solid rgba(168, 85, 247, 0.3);
    }

    .calculator-badge-secondary {
        background: linear-gradient(135deg, rgba(245, 158, 11, 0.2), rgba(251, 191, 36, 0.2));
        color: #f59e0b;
        border: 1px solid rgba(245, 158, 11, 0.3);
    }

    .calculator-formula {
        position: relative;
    }

    .calculator-formula-title {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 1.125rem;
        font-weight: 600;
        color: #e2e8f0;
    }

    .formula-card {
        position: relative;
        overflow: hidden;
    }

    .formula-card::before {
        content: '';
        position: absolute;
        top: -50%;
        left: -50%;
        width: 200%;
        height: 200%;
        background: conic-gradient(transparent, rgba(255, 255, 255, 0.1), transparent);
        opacity: 0;
        transition: opacity 0.3s ease;
        animation: rotate 10s linear infinite;
        pointer-events: none;
    }

    .formula-card:hover::before {
        opacity: 1;
    }

    .calculator-info {
        background: linear-gradient(135deg, rgba(59, 130, 246, 0.1), rgba(16, 185, 129, 0.1));
        border: 1px solid rgba(59, 130, 246, 0.2);
        border-radius: 1rem;
        padding: 1.5rem;
    }

    .calculator-info-title {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 1rem;
        font-weight: 600;
        color: #60a5fa;
        margin-bottom: 1rem;
    }

    .calculator-info-content {
        color: #d1d5db;
    }

    /* Animations */
    @keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    @keyframes rotate {
        to {
            transform: rotate(360deg);
        }
    }

    .calculator-fade-in {
        opacity: 0;
        animation: fadeIn 0.5s ease-out 0.2s forwards;
    }

    .calculator-result-appear {
        animation: slideUp 0.6s ease-out;
    }

    @keyframes slideUp {
        from {
            opacity: 0;
            transform: translateY(30px) scale(0.98);
        }
        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    /* Input status indicators */
    .input-status {
        transition: all 0.3s ease;
    }

    .calculator-input:focus ~ .input-status,
    .calculator-input:valid ~ .input-status {
        display: block !important;
    }

    /* Responsive improvements */
    @media (max-width: 768px) {
        .calculator-input {
            padding: 0.75rem 2.5rem 0.75rem 0.75rem;
            font-size: 0.9rem;
        }

        .calculator-button {
            padding: 0.75rem 1.5rem;
            font-size: 0.9rem;
        }

        .calculator-result {
            padding: 1.5rem;
        }

        .calculator-result-value {
            font-size: 1.5rem;
        }
    }

    /* Enhanced focus states for accessibility */
    .calculator-button:focus-visible {
        outline: 2px solid #a855f7;
        outline-offset: 2px;
    }

    .calculator-input:focus-visible {
        outline: 2px solid #a855f7;
        outline-offset: 2px;
    }

    /* Loading state */
    .calculator-loading {
        display: none !important;
    }

    .calculator-button:disabled .calculate-text {
        opacity: 0;
    }

    .calculator-button:disabled .calculator-loading {
        display: flex !important;
    }

    /* Smooth transitions */
    * {
        scroll-behavior: smooth;
    }
</style>

