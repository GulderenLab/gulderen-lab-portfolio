        // Calculator functions
        window.calculateOhm = function() {
            var voltageEl = document.getElementById('voltage');
            var currentEl = document.getElementById('current');
            var resistanceEl = document.getElementById('resistance');
            var result = document.getElementById('ohm-result');
            if (!voltageEl || !currentEl || !resistanceEl || !result) return;
            var voltage = parseFloat(voltageEl.value);
            var current = parseFloat(currentEl.value);
            var resistance = parseFloat(resistanceEl.value);

            let message = '';
            
            if (!isNaN(voltage) && !isNaN(current)) {
                const calculatedR = voltage / current;
                message += `Direnç: ${calculatedR.toFixed(3)} Ω<br>`;
            }
            if (!isNaN(voltage) && !isNaN(resistance)) {
                const calculatedI = voltage / resistance;
                message += `Akım: ${calculatedI.toFixed(3)} A<br>`;
            }
            if (!isNaN(current) && !isNaN(resistance)) {
                const calculatedV = current * resistance;
                message += `Voltaj: ${calculatedV.toFixed(3)} V<br>`;
            }
            
            result.innerHTML = message || 'Lütfen en az iki değer girin.';
        };

        // Enhanced Ohm calculator with modern UI
        window.calculateOhmEnhanced = function() {
            var voltageEl = document.getElementById('voltage');
            var currentEl = document.getElementById('current');
            var resistanceEl = document.getElementById('resistance');
            var result = document.getElementById('ohm-result-enhanced');
            if (!voltageEl || !currentEl || !resistanceEl || !result) return;
            
            var voltage = parseFloat(voltageEl.value);
            var current = parseFloat(currentEl.value);
            var resistance = parseFloat(resistanceEl.value);
            
            var validInputs = 0;
            var calculations = [];
            
            if (!isNaN(voltage)) validInputs++;
            if (!isNaN(current)) validInputs++;
            if (!isNaN(resistance)) validInputs++;
            
            if (validInputs < 2) {
                result.style.display = 'none';
                return;
            }
            
            // Calculate missing values
            if (!isNaN(voltage) && !isNaN(current)) {
                const calculatedR = voltage / current;
                const power = voltage * current;
                calculations.push({
                    title: 'Hesaplanan Direnç',
                    value: `${calculatedR.toFixed(4)} Ω`,
                    formula: 'R = V ÷ I',
                    power: `Güç: ${power.toFixed(3)} W`
                });
            }
            if (!isNaN(voltage) && !isNaN(resistance)) {
                const calculatedI = voltage / resistance;
                const power = voltage * calculatedI;
                calculations.push({
                    title: 'Hesaplanan Akım',
                    value: `${calculatedI.toFixed(6)} A`,
                    formula: 'I = V ÷ R',
                    power: `Güç: ${power.toFixed(3)} W`
                });
            }
            if (!isNaN(current) && !isNaN(resistance)) {
                const calculatedV = current * resistance;
                const power = calculatedV * current;
                calculations.push({
                    title: 'Hesaplanan Voltaj',
                    value: `${calculatedV.toFixed(4)} V`,
                    formula: 'V = I × R',
                    power: `Güç: ${power.toFixed(3)} W`
                });
            }
            
            if (calculations.length === 0) {
                result.style.display = 'none';
                return;
            }
            
            // Generate result HTML with proper styling
            var html = calculations.map(function(calc, index) {
                return `
                    <div class="calculator-result mb-4 calculator-fade-in">
                        <div class="calculator-result-title">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" class="text-green-400">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                            ${calc.title}
                        </div>
                        <div class="calculator-result-value text-2xl font-bold mb-2">${calc.value}</div>
                        <div class="calculator-result-description">
                            <div class="flex items-center gap-2 mb-1">
                                <span class="calculator-badge calculator-badge-primary">Formül</span>
                                <span class="font-mono text-sm">${calc.formula}</span>
                            </div>
                            <div class="flex items-center gap-2">
                                <span class="calculator-badge calculator-badge-secondary">Güç</span>
                                <span class="text-yellow-400 font-semibold">${calc.power}</span>
                            </div>
                        </div>
                    </div>
                    ${index < calculations.length - 1 ? '<div class="border-t border-slate-600/50 my-4"></div>' : ''}
                `;
            }).join('');
            
            result.innerHTML = html;
            result.style.display = 'block';
            result.classList.add('active', 'calculator-result-appear');
        };

        // Power calculators
        window.calcPowerDC = function() {
            var V = parseFloat((document.getElementById('pdc-v') && document.getElementById('pdc-v').value) || '');
            var I = parseFloat((document.getElementById('pdc-i') && document.getElementById('pdc-i').value) || '');
            var R = parseFloat((document.getElementById('pdc-r') && document.getElementById('pdc-r').value) || '');
            var out = document.getElementById('pdc-out');
            if (!out) return;
            var lines = [];
            if (!isNaN(V) && !isNaN(I)) lines.push(`P = V·I = ${(V*I).toFixed(4)} W`);
            if (!isNaN(V) && !isNaN(R) && R>0) lines.push(`I = V/R = ${(V/R).toFixed(6)} A, P = V²/R = ${((V*V)/R).toFixed(4)} W`);
            if (!isNaN(I) && !isNaN(R) && R>0) lines.push(`V = I·R = ${(I*R).toFixed(6)} V, P = I²·R = ${((I*I)*R).toFixed(4)} W`);
            out.innerHTML = lines.length ? lines.map(l=>`<div>${l}</div>`).join('') : 'En az iki değişken girin (V, I, R).';
        };

        window.calcPowerAC1 = function() {
            var V = parseFloat((document.getElementById('pac1-v') && document.getElementById('pac1-v').value) || '');
            var I = parseFloat((document.getElementById('pac1-i') && document.getElementById('pac1-i').value) || '');
            var PF = parseFloat((document.getElementById('pac1-pf') && document.getElementById('pac1-pf').value) || '');
            var type = (document.getElementById('pac1-type') && document.getElementById('pac1-type').value) || 'lagging';
            var out = document.getElementById('pac1-out');
            if (!out) return;
            if ([V,I,PF].some(function(x){return isNaN(x)||x<=0;}) || PF>1) { out.textContent='Geçerli V, I, PF girin.'; return; }
            var S = V*I; // VA
            var P = S*PF; // W
            var Q = Math.sqrt(Math.max(0, S*S - P*P)); // var
            var sign = type==='leading' ? '-' : '+';
            out.innerHTML = `S ≈ ${S.toFixed(3)} VA<br>P ≈ ${P.toFixed(3)} W<br>Q ≈ ${sign}${Q.toFixed(3)} var`;
        };

        window.calcPowerAC3 = function() {
            var VLL = parseFloat((document.getElementById('pac3-vll') && document.getElementById('pac3-vll').value) || '');
            var I = parseFloat((document.getElementById('pac3-i') && document.getElementById('pac3-i').value) || '');
            var PF = parseFloat((document.getElementById('pac3-pf') && document.getElementById('pac3-pf').value) || '');
            var conn = (document.getElementById('pac3-conn') && document.getElementById('pac3-conn').value) || 'wye';
            var out = document.getElementById('pac3-out');
            if (!out) return;
            if ([VLL,I,PF].some(function(x){return isNaN(x)||x<=0;}) || PF>1) { out.textContent='Geçerli VLL, I, PF girin.'; return; }
            var S = Math.sqrt(3) * VLL * I; // VA
            var P = S * PF; // W
            var Q = Math.sqrt(Math.max(0, S*S - P*P)); // var
            // Bilgi: bağlantıya göre faz gerilimi/akımı değişir fakat toplam görünür güç formülü S=√3·VLL·IL dengeli sistemde geçerlidir.
            out.innerHTML = `S ≈ ${S.toFixed(3)} VA<br>P ≈ ${P.toFixed(3)} W<br>Q ≈ ${Q.toFixed(3)} var<br><span class="text-xs text-gray-300">Bağlantı: ${conn.toUpperCase()}</span>`;
        };

        window.calcPowerEfficiency = function() {
            var Pin = parseFloat((document.getElementById('peff-pin') && document.getElementById('peff-pin').value) || '');
            var Eff = parseFloat((document.getElementById('peff-eff') && document.getElementById('peff-eff').value) || '');
            var Vin = parseFloat((document.getElementById('lin-vin') && document.getElementById('lin-vin').value) || '');
            var Vout = parseFloat((document.getElementById('lin-vout') && document.getElementById('lin-vout').value) || '');
            var Iout = parseFloat((document.getElementById('lin-iout') && document.getElementById('lin-iout').value) || '');
            var out = document.getElementById('peff-out');
            if (!out) return;
            var lines = [];

            if (!isNaN(Pin) && !isNaN(Eff) && Eff>0) {
                var eta = Math.max(0.01, Math.min(1, Eff/100));
                var Pout = Pin * eta;
                var Pdiss = Pin - Pout;
                lines.push(`P_out ≈ ${Pout.toFixed(3)} W, P_diss ≈ ${Pdiss.toFixed(3)} W (η=${(eta*100).toFixed(1)}%)`);
            }
            if (!isNaN(Vin) && !isNaN(Vout) && !isNaN(Iout) && Iout>=0 && Vin>Vout) {
                var Pd_lin = (Vin - Vout) * Iout;
                lines.push(`Linear Reg. kayıp ≈ ${Pd_lin.toFixed(3)} W`);
            }

            out.innerHTML = lines.length ? lines.map(function(l){return `<div>${l}</div>`;}).join('') : 'Verim için Pin & verim, Linear için Vin/Vout/Iout girin.';
        };

        window.convertFrequency = function() {
            var valueEl = document.getElementById('freq-value');
            var unitEl = document.getElementById('freq-unit');
            var results = document.getElementById('frequency-results');
            if (!valueEl || !unitEl || !results) return;
            var value = parseFloat(valueEl.value);
            var unit = unitEl.value;

            if (isNaN(value)) {
                results.innerHTML = '<p class="text-red-400">Lütfen geçerli bir değer girin.</p>';
                return;
            }

            // Convert to Hz first
            var hz;
            switch(unit) {
                case 'hz': hz = value; break;
                case 'khz': hz = value * 1000; break;
                case 'mhz': hz = value * 1000000; break;
                case 'ghz': hz = value * 1000000000; break;
                default: hz = value;
            }

            results.innerHTML = `
                <div class="bg-slate-700/50 rounded-lg p-4 space-y-2">
                    <p class="text-white"><span class="font-medium">Hz:</span> ${hz.toLocaleString()}</p>
                    <p class="text-white"><span class="font-medium">kHz:</span> ${(hz/1000).toLocaleString()}</p>
                    <p class="text-white"><span class="font-medium">MHz:</span> ${(hz/1000000).toLocaleString()}</p>
                    <p class="text-white"><span class="font-medium">GHz:</span> ${(hz/1000000000).toLocaleString()}</p>
                    <p class="text-white"><span class="font-medium">Periyot:</span> ${(1/hz).toExponential(3)} s</p>
                </div>
            `;
        };

        window.convertFromBase = function(fromBase) {
            var inputEl = document.getElementById('number-input');
            var results = document.getElementById('number-results');
            if (!inputEl || !results) return;
            var input = inputEl.value.trim();

            if (!input) {
                results.innerHTML = '<p class="text-red-400">Lütfen bir sayı girin.</p>';
                return;
            }

            try {
                const decimal = parseInt(input, fromBase);
                if (isNaN(decimal)) {
                    results.innerHTML = '<p class="text-red-400">Geçersiz sayı formatı.</p>';
                    return;
                }

                results.innerHTML = `
                    <div class="bg-slate-700/50 rounded-lg p-4 space-y-2">
                        <p class="text-white"><span class="font-medium">Decimal:</span> ${decimal}</p>
                        <p class="text-white"><span class="font-medium">Binary:</span> ${decimal.toString(2)}</p>
                        <p class="text-white"><span class="font-medium">Hexadecimal:</span> ${decimal.toString(16).toUpperCase()}</p>
                        <p class="text-white"><span class="font-medium">Octal:</span> ${decimal.toString(8)}</p>
                    </div>
                `;
            } catch (error) {
                results.innerHTML = '<p class="text-red-400">Dönüştürme hatası.</p>';
            }
        };

        window.convertTemperature = function() {
            var valEl = document.getElementById('temp-value');
            var fromEl = document.getElementById('temp-from');
            var results = document.getElementById('temperature-results');
            if (!valEl || !fromEl || !results) return;
            var value = parseFloat(valEl.value);
            var from = fromEl.value;

            if (isNaN(value)) {
                results.innerHTML = '<p class="text-red-400">Lütfen geçerli bir değer girin.</p>';
                return;
            }

            var celsius, fahrenheit, kelvin;

            // Convert to Celsius first
            switch(from) {
                case 'celsius':
                    celsius = value;
                    break;
                case 'fahrenheit':
                    celsius = (value - 32) * 5/9;
                    break;
                case 'kelvin':
                    celsius = value - 273.15;
                    break;
            }

            // Convert from Celsius to others
            fahrenheit = (celsius * 9/5) + 32;
            kelvin = celsius + 273.15;

            results.innerHTML = `
                <div class="bg-slate-700/50 rounded-lg p-4 space-y-2">
                    <p class="text-white"><span class="font-medium">Celsius:</span> ${celsius.toFixed(2)} °C</p>
                    <p class="text-white"><span class="font-medium">Fahrenheit:</span> ${fahrenheit.toFixed(2)} °F</p>
                    <p class="text-white"><span class="font-medium">Kelvin:</span> ${kelvin.toFixed(2)} K</p>
                </div>
            `;
        };

        // Data size converter
        window.convertDataSize = function() {
            var value = parseFloat((document.getElementById('ds-value') && document.getElementById('ds-value').value) || '');
            var unit = (document.getElementById('ds-unit') && document.getElementById('ds-unit').value);
            var out = document.getElementById('ds-result');
            if (!out || isNaN(value) || value < 0) { if(out) out.textContent = 'Geçerli bir değer girin.'; return; }
            var multipliers = {B:1, KB:1024, MB:1024**2, GB:1024**3, TB:1024**4};
            var bytes = value * multipliers[unit || 'B'];
            var lines = [];
            lines.push(`<p class="text-white">Byte: ${(bytes).toLocaleString()}</p>`);
            lines.push(`<p class="text-white">KB: ${(bytes/1024).toLocaleString()}</p>`);
