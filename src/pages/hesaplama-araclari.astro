        function hexStringToBytes(str) {
            var clean = str.replace(/\s+/g, '').toLowerCase();
            if (clean.length % 2 !== 0) return null;
            var bytes = [];
            for (var i=0;i<clean.length;i+=2) {
                var byte = parseInt(clean.substr(i,2),16);
                if (isNaN(byte)) return null;
                bytes.push(byte);
            }
            return bytes;
        }
