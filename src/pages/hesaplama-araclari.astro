        window.calcCRC = function() {
            var input = ((document.getElementById('crc-input') && document.getElementById('crc-input').value) || '').trim();
            var type = (document.getElementById('crc-type') && document.getElementById('crc-type').value) || 'crc32';
            var out = document.getElementById('crc-result');
            if (!out || !input) { if(out) out.textContent='Girdi boş olamaz.'; return; }

            // Decide if hex or ASCII
            var bytes = hexStringToBytes(input);
            if (!bytes) bytes = textToBytes(input);

            var crc;
            if (type === 'crc8') {
                crc = 0x00;
                var poly8 = 0x07;
                bytes.forEach(function(b){
                    crc ^= b;
                    for (var i=0;i<8;i++){
                        crc = (crc & 0x80) ? ((crc<<1) ^ poly8) : (crc<<1);
                        crc &= 0xFF;
                    }
                });
                out.textContent = `CRC-8: 0x${crc.toString(16).toUpperCase().padStart(2,'0')}`;
            } else if (type === 'crc16') {
                var crc16 = 0xFFFF; // CRC-16-IBM
                bytes.forEach(function(b){
                    crc16 ^= b;
                    for (var i=0;i<8;i++){
                        if (crc16 & 0x0001) crc16 = (crc16>>1) ^ 0xA001;
                        else crc16 >>= 1;
                    }
                });
                out.textContent = `CRC-16: 0x${crc16.toString(16).toUpperCase().padStart(4,'0')}`;
            } else {
                var crc32 = 0xFFFFFFFF;
                bytes.forEach(function(b){
                    var cur = (crc32 ^ b) & 0xFF;
                    for (var i=0;i<8;i++){
                        var mask = -(cur & 1);
                        cur = (cur >>> 1) ^ (0xEDB88320 & mask);
                    }
                    crc32 = (crc32 >>> 8) ^ cur;
                });
                crc32 = (crc32 ^ 0xFFFFFFFF) >>> 0;
                out.textContent = `CRC-32: 0x${crc32.toString(16).toUpperCase().padStart(8,'0')}`;
            }
        };

