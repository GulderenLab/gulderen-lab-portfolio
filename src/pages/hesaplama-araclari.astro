            var C = parseFloat((document.getElementById('rc-c') && document.getElementById('rc-c').value) || '');
            var res = document.getElementById('rc-result');
            if (!res || isNaN(R) || R <= 0 || isNaN(C) || C <= 0) { if(res) res.textContent='Geçerli R ve C girin.'; return; }
            var tau = R * C;
            res.innerHTML = `τ = ${tau.toExponential(6)} s<br>%99.3 ≈ ${(5*tau).toExponential(6)} s`;
        };

        window.calcLedRes = function() {
            var Vs = parseFloat((document.getElementById('led-vs') && document.getElementById('led-vs').value) || '');
            var Vf = parseFloat((document.getElementById('led-vf') && document.getElementById('led-vf').value) || '');
            var I_mA = parseFloat((document.getElementById('led-i') && document.getElementById('led-i').value) || '');
            var res = document.getElementById('led-result');
            if (!res || isNaN(Vs) || isNaN(Vf) || isNaN(I_mA) || I_mA <= 0) { if(res) res.textContent='Geçerli değerler girin.'; return; }
            var I = I_mA / 1000;
            var R = (Vs - Vf) / I;
            var P = I*I*R;
            res.innerHTML = `R ≈ ${R.toFixed(1)} Ω, Güç ≈ ${P.toFixed(3)} W`;
        };

        function parseResList() {
            var txt = (document.getElementById('res-list') && document.getElementById('res-list').value) || '';
            return txt.split(',').map(function(s){ return parseFloat(s.trim()); }).filter(function(v){ return !isNaN(v) && v>0; });
        }
        window.calcResSeries = function() {
            var arr = parseResList();
            var res = document.getElementById('res-combine-result');
            if (!res || arr.length===0) { if(res) res.textContent='Geçerli liste girin.'; return; }
            var eq = arr.reduce(function(a,b){ return a+b; }, 0);
            res.textContent = `R_seri = ${eq.toFixed(3)} Ω`;
        };
        window.calcResParallel = function() {
            var arr = parseResList();
            var res = document.getElementById('res-combine-result');
            if (!res || arr.length===0) { if(res) res.textContent='Geçerli liste girin.'; return; }
            var inv = arr.reduce(function(a,b){ return a + 1/b; }, 0);
            var eq = 1/inv;
            res.textContent = `R_paralel = ${eq.toFixed(3)} Ω`;
        };

        window.calcReactive = function() {
            var f = parseFloat((document.getElementById('rx-f') && document.getElementById('rx-f').value) || '');
            var C = parseFloat((document.getElementById('rx-c') && document.getElementById('rx-c').value) || '0');
            var L = parseFloat((document.getElementById('rx-l') && document.getElementById('rx-l').value) || '0');
            var res = document.getElementById('rx-result');
            if (!res || isNaN(f) || f<=0) { if(res) res.textContent='Geçerli frekans girin.'; return; }
            var Xc = C>0 ? 1/(2*Math.PI*f*C) : null;
            var Xl = L>0 ? 2*Math.PI*f*L : null;
            var msg = [];
            if (Xc!==null) msg.push(`Xc = ${Xc.toFixed(3)} Ω`);
            if (Xl!==null) msg.push(`Xl = ${Xl.toFixed(3)} Ω`);
            res.innerHTML = msg.join('<br>') || 'C veya L girin.';
        };

        window.calcDividerLoad = function() {
            var Vin = parseFloat((document.getElementById('vd-vin') && document.getElementById('vd-vin').value) || '');
            var R1 = parseFloat((document.getElementById('vd-r1') && document.getElementById('vd-r1').value) || '');
            var R2 = parseFloat((document.getElementById('vd-r2') && document.getElementById('vd-r2').value) || '');
            var RL = parseFloat((document.getElementById('vd-rl') && document.getElementById('vd-rl').value) || '');
            var res = document.getElementById('vd-result');
            if (!res || [Vin,R1,R2].some(function(v){return isNaN(v)||v<=0;})) { if(res) res.textContent='Vin, R1, R2 girin.'; return; }
            var R2eff = (!isNaN(RL) && RL>0) ? 1 / (1/R2 + 1/RL) : R2;
            var Vout = Vin * R2eff / (R1 + R2eff);
            res.innerHTML = `Vout ≈ ${Vout.toFixed(4)} V${(R2eff!==R2)?' (yük etkisi dahil)':''}`;
        };

        window.calcBatteryAdvanced = function() {
            var C_mAh = parseFloat((document.getElementById('bat-cap') && document.getElementById('bat-cap').value) || '');
            var Ion_mA = parseFloat((document.getElementById('bat-ion') && document.getElementById('bat-ion').value) || '');
            var Ton_s = parseFloat((document.getElementById('bat-ton') && document.getElementById('bat-ton').value) || '');
            var Isleep_uA = parseFloat((document.getElementById('bat-isleep-ua') && document.getElementById('bat-isleep-ua').value) || '');
            var Tsleep_s = parseFloat((document.getElementById('bat-tsleep') && document.getElementById('bat-tsleep').value) || '');
            var eff_pct = parseFloat((document.getElementById('bat-eff') && document.getElementById('bat-eff').value) || '');
            var safety_pct = parseFloat((document.getElementById('bat-safety') && document.getElementById('bat-safety').value) || '0');
            var npar = parseInt((document.getElementById('bat-npar') && document.getElementById('bat-npar').value) || '1',10);
            var out = document.getElementById('bat-result');

            if (!out || [C_mAh, Ion_mA, Ton_s, Isleep_uA, Tsleep_s, eff_pct].some(function(v){return isNaN(v) || v < 0;}) || isNaN(npar) || npar<=0) {
                if(out) out.textContent = 'Tüm girişleri kontrol edin.'; 
                return;
            }
            var Tcycle = Ton_s + Tsleep_s; 
            if (Tcycle <= 0) { out.textContent = 'T_on + T_sleep > 0 olmalı.'; return; }

            // Ortalama yük akımı (mA) – Isleep in µA => mA
            var Isleep_mA = Isleep_uA / 1000.0;
            var Iavg_load_mA = (Ion_mA * Ton_s + Isleep_mA * Tsleep_s) / Tcycle;

            // Verim – pilden çekilen ortalama akım
            var eta = Math.max(0.01, Math.min(1.0, eff_pct / 100.0));
            var Iavg_batt_mA = Iavg_load_mA / eta;

            // Efektif kapasite (paralel sayısı ve güvenlik payı)
            var safety = Math.max(0, Math.min(100, isNaN(safety_pct)?0:safety_pct));
            var Ceffective_mAh = C_mAh * npar * (1 - safety/100);

            if (Ceffective_mAh <= 0 || Iavg_batt_mA <= 0) {
                out.textContent = 'Efektif kapasite ve akım > 0 olmalı.';
                return;
            }

            // Saat cinsinden ömür
            var hours = Ceffective_mAh / Iavg_batt_mA;
            // İnsan-dostu biçim: gün-saat
            var days = Math.floor(hours / 24);
            var remHours = hours - days*24;

            out.innerHTML = `
                Ortalama yük akımı ≈ ${Iavg_load_mA.toFixed(3)} mA<br>
                Pil ort. akımı (η dahil) ≈ ${Iavg_batt_mA.toFixed(3)} mA<br>
                Efektif kapasite ≈ ${Ceffective_mAh.toFixed(0)} mAh<br>
                Tahmini ömür ≈ ${hours.toFixed(1)} saat (${days} gün ${remHours.toFixed(1)} saat)
            `;
        };

        window.calcPwm = function() {
            var fclk = parseFloat((document.getElementById('pwm-fclk') && document.getElementById('pwm-fclk').value) || '');
            var psc = parseFloat((document.getElementById('pwm-psc') && document.getElementById('pwm-psc').value) || '');
            var arr = parseFloat((document.getElementById('pwm-arr') && document.getElementById('pwm-arr').value) || '');
            var res = document.getElementById('pwm-result');
            if (!res || [fclk,psc,arr].some(function(v){return isNaN(v)||v<=0;})) { if(res) res.textContent='Geçerli fclk, prescaler ve ARR girin.'; return; }
            var fPWM = fclk / (psc * (arr + 1));
            var dutyStep = 1 / (arr + 1);
            var tStep = 1 / fclk * psc;
            res.innerHTML = `f_PWM ≈ ${fPWM.toFixed(3)} Hz<br>Duty çözünürlüğü ≈ ${(dutyStep*100).toFixed(3)} % adım<br>Zaman çözünürlüğü ≈ ${tStep.toExponential(6)} s`;
        };

        window.calcAdc = function() {
            var N = parseInt((document.getElementById('adc-n') && document.getElementById('adc-n').value) || '0',10);
            var Vref = parseFloat((document.getElementById('adc-vref') && document.getElementById('adc-vref').value) || '');
            var Vin = parseFloat((document.getElementById('adc-vin') && document.getElementById('adc-vin').value) || '');
            var res = document.getElementById('adc-result');
            if (!res || isNaN(N) || N<=0 || isNaN(Vref) || Vref<=0) { if(res) res.textContent='Geçerli N ve Vref girin.'; return; }
            var levels = Math.pow(2,N);
            var lsb = Vref / levels;
            var code = (!isNaN(Vin)) ? Math.max(0, Math.min(levels-1, Math.floor(Vin / lsb))) : null;
            res.innerHTML = `Seviye sayısı: ${levels}<br>LSB ≈ ${lsb.toExponential(6)} V${(code!==null)?`<br>Kod ≈ ${code}`:''}`;
        };

        // LT3045 Calculator Functions
        window.calculateLT3045 = function() {
            var voutEl = document.getElementById('lt3045-vout');
            var knownResistorEl = document.getElementById('lt3045-known-resistor');
            var knownValueEl = document.getElementById('lt3045-known-value');
            var knownUnitEl = document.getElementById('lt3045-known-unit');
            var vPgfbMinEl = document.getElementById('lt3045-vpgfb-min');
            var vPgfbMaxEl = document.getElementById('lt3045-vpgfb-max');
            var resultsDiv = document.getElementById('lt3045-results');
            var theoreticalMin = document.getElementById('lt3045-theoretical-min');
            var theoreticalMax = document.getElementById('lt3045-theoretical-max');
            var standardMin = document.getElementById('lt3045-standard-min');
            var standardMax = document.getElementById('lt3045-standard-max');
            var circuitDiagram = document.getElementById('lt3045-circuit-diagram');
            if (!voutEl || !knownResistorEl || !knownValueEl || !knownUnitEl || !vPgfbMinEl || !vPgfbMaxEl || !resultsDiv || !theoreticalMin || !theoreticalMax || !standardMin || !standardMax || !circuitDiagram) return;
            var vout = parseFloat(voutEl.value);
            var knownResistor = knownResistorEl.value;
            var knownValue = parseFloat(knownValueEl.value);
            var knownUnit = knownUnitEl.value;
            var vPgfbMin = parseFloat(vPgfbMinEl.value);
            var vPgfbMax = parseFloat(vPgfbMaxEl.value);

            if (!vout || !knownValue || !vPgfbMin || !vPgfbMax) {
                alert('Lütfen tüm alanları doldurun!');
                return;
            }

// Standard resistor values (E24 series)
            var standardResistors = [
                1.0, 1.1, 1.2, 1.3, 1.5, 1.6, 1.8, 2.0, 2.2, 2.4, 2.7, 3.0,
                3.3, 3.6, 3.9, 4.3, 4.7, 5.1, 5.6, 6.2, 6.8, 7.5, 8.2, 9.1
            ];
            
            // Unit conversion functions
            var convertToOhms = function(value, unit) {
                var multipliers = { 'ohm': 1, 'kohm': 1000, 'Mohm': 1000000 };
                return value * multipliers[unit];
            };
            var convertFromOhms = function(value, unit) {
                var multipliers = { 'ohm': 1, 'kohm': 1000, 'Mohm': 1000000 };
                return value / multipliers[unit];
            };

            var formatValue = function(value) {
                if (value >= 1000000) {
                    return `${(value / 1000000).toFixed(2)} MΩ`;
                } else if (value >= 1000) {
                    return `${(value / 1000).toFixed(2)} kΩ`;
                } else {
                    return `${value.toFixed(2)} Ω`;
                }
            };

            // Find nearest standard resistor
            var findNearestStandardResistor = function(targetValue, unit) {
                var targetInOhms = convertToOhms(targetValue, unit);
                var bestMatch = null;
                var minDifference = Infinity;

                for (var decade = 0.1; decade <= 10000000; decade *= 10) {
                    standardResistors.forEach(function(base) {
                        var candidate = base * decade;
                        var difference = Math.abs(candidate - targetInOhms);
                        if (difference < minDifference) {
                            minDifference = difference;
                            bestMatch = candidate;
                        }
                    });
                }

                return {
                    value: convertFromOhms(bestMatch, unit),
                    ohms: bestMatch,
                    percentError: ((bestMatch - targetInOhms) / targetInOhms * 100)
                };
            };

            const knownInOhms = convertToOhms(knownValue, knownUnit);
            const keepKnownConstant = knownInOhms; // Keep known resistor constant
            
            // Calculate resistor values for min and max conditions
            var r1Min, r2Min, r1Max, r2Max;
            
            if (knownResistor === 'R1') {
                r1Min = r1Max = knownInOhms;
                r2Min = (vPgfbMin * knownInOhms) / (vout - vPgfbMin);
                r2Max = (vPgfbMax * knownInOhms) / (vout - vPgfbMax);
            } else {
                r2Min = r2Max = knownInOhms;
                r1Min = knownInOhms * (vout - vPgfbMin) / vPgfbMin;
                r1Max = knownInOhms * (vout - vPgfbMax) / vPgfbMax;
            }

            // Find standard resistor recommendations (keep known resistor constant)
            var r1MinStd, r1MaxStd, r2MinStd, r2MaxStd;
            
            if (knownResistor === 'R1') {
                // Keep R1 constant at the known value
                r1MinStd = { value: knownValue, ohms: keepKnownConstant, percentError: 0 };
                r1MaxStd = { value: knownValue, ohms: keepKnownConstant, percentError: 0 };
                
                // Find standard values for R2
                r2MinStd = findNearestStandardResistor(convertFromOhms(r2Min, knownUnit), knownUnit);
                r2MaxStd = findNearestStandardResistor(convertFromOhms(r2Max, knownUnit), knownUnit);
            } else {
                // Keep R2 constant at the known value
                r2MinStd = { value: knownValue, ohms: keepKnownConstant, percentError: 0 };
                r2MaxStd = { value: knownValue, ohms: keepKnownConstant, percentError: 0 };
                
                // Find standard values for R1
                r1MinStd = findNearestStandardResistor(convertFromOhms(r1Min, knownUnit), knownUnit);
                r1MaxStd = findNearestStandardResistor(convertFromOhms(r1Max, knownUnit), knownUnit);
            }

            // Calculate actual voltages with standard resistors
            const actualVPgfbMin = vout * r2MinStd.ohms / (r1MinStd.ohms + r2MinStd.ohms);
            const actualVPgfbMax = vout * r2MaxStd.ohms / (r1MaxStd.ohms + r2MaxStd.ohms);

            // Update UI
            theoreticalMin.innerHTML = `
                <p>R1 = ${convertFromOhms(r1Min, knownUnit).toFixed(3)} ${knownUnit}</p>
                <p>R2 = ${convertFromOhms(r2Min, knownUnit).toFixed(3)} ${knownUnit}</p>
                <p>V<sub>PGFB</sub> = ${vPgfbMin}V</p>
            `;

            theoreticalMax.innerHTML = `
                <p>R1 = ${convertFromOhms(r1Max, knownUnit).toFixed(3)} ${knownUnit}</p>
                <p>R2 = ${convertFromOhms(r2Max, knownUnit).toFixed(3)} ${knownUnit}</p>
                <p>V<sub>PGFB</sub> = ${vPgfbMax}V</p>
            `;

            standardMin.innerHTML = `
                <p><strong>R1:</strong> ${formatValue(r1MinStd.ohms)} 
                   <span class="text-green-400">(${r1MinStd.percentError > 0 ? '+' : ''}${r1MinStd.percentError.toFixed(1)}%)</span></p>
                <p><strong>R2:</strong> ${formatValue(r2MinStd.ohms)} 
                   <span class="text-green-400">(${r2MinStd.percentError > 0 ? '+' : ''}${r2MinStd.percentError.toFixed(1)}%)</span></p>
                <p><strong>Gerçek V<sub>PGFB</sub>:</strong> ${actualVPgfbMin.toFixed(3)}V</p>
            `;

            standardMax.innerHTML = `
                <p><strong>R1:</strong> ${formatValue(r1MaxStd.ohms)} 
                   <span class="text-orange-400">(${r1MaxStd.percentError > 0 ? '+' : ''}${r1MaxStd.percentError.toFixed(1)}%)</span></p>
                <p><strong>R2:</strong> ${formatValue(r2MaxStd.ohms)} 
                   <span class="text-orange-400">(${r2MaxStd.percentError > 0 ? '+' : ''}${r2MaxStd.percentError.toFixed(1)}%)</span></p>
                <p><strong>Gerçek V<sub>PGFB</sub>:</strong> ${actualVPgfbMax.toFixed(3)}V</p>
            `;

            circuitDiagram.innerHTML = `
                <div>Vout (${vout}V) ──┬──── (+)</div>
                <div class="ml-16">│</div>
                <div class="ml-16">R1</div>
                <div class="ml-16">│</div>
                <div class="ml-12">├──── V<sub>PGFB</sub></div>
                <div class="ml-16">│</div>
                <div class="ml-16">R2</div>
                <div class="ml-16">│</div>
                <div class="ml-12">└──── GND</div>
            `;

            resultsDiv.classList.remove('hidden');
        };

        // Search + filter state
        var state = { query: '', category: null };

        function applyFilters() {
            var q = state.query.toLowerCase();
            var cat = state.category;
            var visibleCalcCountByCategory = {};

            // filter calculators
            document.querySelectorAll('.calculator-item').forEach(function(item){
                var name = item.getAttribute('data-name') || '';
                var catName = item.getAttribute('data-category') || '';
                var matchQuery = !q || name.includes(q) || catName.includes(q);
                var matchCategory = !cat || catName === cat;
                var show = matchQuery && matchCategory;
                item.style.display = show ? '' : 'none';
                var parentCard = item.closest('.category-card');
                var parentCategory = parentCard ? (parentCard.getAttribute('data-category') || '') : '';
                if (show) {
                    visibleCalcCountByCategory[parentCategory] = (visibleCalcCountByCategory[parentCategory] || 0) + 1;
                }
            });

            // hide empty category cards
            document.querySelectorAll('.category-card').forEach(function(card){
                var catTitle = card.getAttribute('data-category') || '';
                var count = visibleCalcCountByCategory[catTitle] || 0;
                card.style.display = count > 0 ? '' : 'none';
                // update "X araç" badge
                var badge = card.querySelector('span.text-xs');
                if (badge) badge.textContent = count + ' araç';
            });
        }

        // Search events
        if (searchInput) {
            searchInput.addEventListener('input', function(){
                state.query = this.value;
                if (clearSearchBtn) clearSearchBtn.classList.toggle('hidden', this.value.length === 0);
                applyFilters();
            });
        }
        if (clearSearchBtn) {
            clearSearchBtn.addEventListener('click', function(){
                searchInput.value = '';
                state.query = '';
                clearSearchBtn.classList.add('hidden');
                applyFilters();
                searchInput.focus();
            });
        }

        // Filter chip events (toggle select one)
        activeFilters?.querySelectorAll('.filter-chip').forEach(function(chip){
