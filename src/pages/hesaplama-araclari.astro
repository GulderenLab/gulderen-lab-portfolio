        // WiFi serbest uzay menzil hesabı (hassasiyet + marj)
        window.calcWifiRange = function() {
            var Pt = parseFloat((document.getElementById('wifi-pt') && document.getElementById('wifi-pt').value) || '');
            var Gt = parseFloat((document.getElementById('wifi-gt') && document.getElementById('wifi-gt').value) || '');
            var Gr = parseFloat((document.getElementById('wifi-gr') && document.getElementById('wifi-gr').value) || '');
            var fMHz = parseFloat((document.getElementById('wifi-band') && document.getElementById('wifi-band').value) || '');
            var Sens = parseFloat((document.getElementById('wifi-sens') && document.getElementById('wifi-sens').value) || '');
            var Margin = parseFloat((document.getElementById('wifi-margin') && document.getElementById('wifi-margin').value) || '0');
            var out = document.getElementById('wifi-result');
            if (!out || [Pt,Gt,Gr,fMHz,Sens,Margin].some(function(v){return isNaN(v);})){ if(out) out.textContent='Tüm alanları doldurun.'; return; }

            // Eşitlik: Pr = Pt + Gt + Gr - FSPL - Margin
            // Pr >= Sens için d[km] = 10^((Pt+Gt+Gr - Sens - Margin - 32.44 - 20log10(fMHz))/20)
            var exp = (Pt + Gt + Gr - Sens - Margin - 32.44 - 20*Math.log10(fMHz)) / 20;
            var dKm = Math.pow(10, exp);
            var dM = dKm * 1000;

            if (!isFinite(dM) || dM <= 0) { out.textContent = 'Parametreleri kontrol edin (sonuç geçersiz).'; return; }

            // Ayrıca FSPL @ 100m bilgi amaçlı
            var fspl100m = 32.44 + 20*Math.log10(fMHz) + 20*Math.log10(0.1);
            out.innerHTML = `Tahmini menzil ≈ ${dM.toFixed(1)} m (LOS)<br><span class="text-xs text-gray-300">FSPL@100m ≈ ${fspl100m.toFixed(1)} dB, Marj: ${Margin.toFixed(1)} dB</span>`;
        };

        window.calcI2CPullup = function() {
            var cpf = parseFloat((document.getElementById('i2c-cpf') && document.getElementById('i2c-cpf').value) || '');
            var tr = parseFloat((document.getElementById('i2c-tr') && document.getElementById('i2c-tr').value) || '');
            var v = parseFloat((document.getElementById('i2c-v') && document.getElementById('i2c-v').value) || '');
            var out = document.getElementById('i2c-result');
            if (!out || [cpf,tr].some(function(x){return isNaN(x)||x<=0;})) { if(out) out.textContent='C ve Tr girin.'; return; }
            // Convert pF -> F, ns -> s
            var C = cpf * 1e-12;
            var Tr = tr * 1e-9;
            // From I2C spec approx: Tr ≈ 0.8473 · Rp · C  => Rp ≈ Tr/(0.8473·C)
            var Rp = Tr / (0.8473 * C);
            var Ipull = v / Rp;
            out.innerHTML = `Önerilen en büyük Rp ≈ ${Rp.toFixed(0)} Ω<br>Pull-up akımı ≈ ${Ipull.toExponential(3)} A`;
        };

        window.calcUartError = function() {
            var fclk = parseFloat((document.getElementById('uart-clk') && document.getElementById('uart-clk').value) || '');
            var baud = parseFloat((document.getElementById('uart-baud') && document.getElementById('uart-baud').value) || '');
            var ovs = parseInt((document.getElementById('uart-ovs') && document.getElementById('uart-ovs').value) || '16',10);
            var out = document.getElementById('uart-result');
            if (!out || [fclk,baud].some(function(x){return isNaN(x)||x<=0;}) || isNaN(ovs) || ovs<=0) { if(out) out.textContent='Saat, baud ve oversample girin.'; return; }
            // Divider = fclk / (ovs * baud)
            var idealDiv = fclk / (ovs * baud);
            var divInt = Math.max(1, Math.round(idealDiv));
            var actualBaud = fclk / (ovs * divInt);
            var err = (actualBaud - baud) / baud * 100;
            out.innerHTML = `Bölücü ≈ ${divInt}<br>Gerçek baud ≈ ${actualBaud.toFixed(2)}<br>Hata ≈ ${err.toFixed(3)} %`;
