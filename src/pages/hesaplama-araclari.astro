                var val = this.getAttribute('data-filter');
                if (state.category === val) {
                    state.category = null;
                    this.classList.remove('ring-2','ring-purple-500','text-white','bg-slate-700/70');
                } else {
                    state.category = val;
                    activeFilters.querySelectorAll('.filter-chip').forEach(function(c){
