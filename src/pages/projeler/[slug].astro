---
// src/pages/projeler/[slug].astro
import { render, type CollectionEntry } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import { getPublished } from '../../lib/content';

export async function getStaticPaths() {
  const all = await getPublished('projeler');
  return all.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, all },
  }));
}

type Props = {
  entry: CollectionEntry<'projeler'>;
  all: CollectionEntry<'projeler'>[];
};

const { entry, all } = Astro.props;
const { Content, headings } = await render(entry);
---

<PostLayout kind="projeler" entry={entry} all={all} headings={headings}>
  <Content />
</PostLayout>
