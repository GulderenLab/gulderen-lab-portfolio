---
// src/pages/projeler/index.astro
import Layout from '../../layouts/Layout.astro';
import SimpleSearch from '../../components/SimpleSearch.astro';
import { getCollection } from 'astro:content';

const pageTitle = "Projeler";
const pageDescription = "Elektornik, yazılım geliştirme ve diğer alanlardaki projelerim.";

// Projeleri al, taslak olmayanları filtrele ve tarihe göre sırala
const projeler = (await getCollection('projeler'))
    .filter(proje => !proje.data.isDraft)
    .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---
<Layout title={pageTitle} description={pageDescription}>
{/* Professional Projects Header */}
  <section class="relative py-20 md:py-32 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-slate-900 via-blue-900/10 to-cyan-900/10"></div>
    <div class="absolute inset-0">
      <div class="absolute top-20 right-20 w-72 h-72 bg-blue-500/5 rounded-full blur-3xl"></div>
      <div class="absolute bottom-20 left-20 w-96 h-96 bg-cyan-500/5 rounded-full blur-3xl"></div>
    </div>
    
    <div class="relative container mx-auto px-6 text-center">
      {/* Section Badge */}
      <div class="inline-flex items-center px-4 py-2 mb-8 bg-slate-800/50 backdrop-blur-sm border border-slate-700/50 rounded-full">
        <svg class="w-4 h-4 mr-2 text-blue-400" fill="currentColor" viewBox="0 0 24 24">
          <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z"/>
        </svg>
        <span class="text-sm text-blue-400 font-medium">Teknik İçerikler</span>
      </div>
      
      <h1 class="text-5xl md:text-6xl font-bold mb-6">
        <span class="bg-gradient-to-r from-white via-blue-100 to-cyan-100 bg-clip-text text-transparent">
          Projelerim
        </span>
      </h1>
      
      <p class="text-xl text-gray-300 max-w-3xl mx-auto mb-12 leading-relaxed">
        Elektronik, yazılım ve teknoloji proje örneklerim.
      </p>
      
      {/* Enhanced Search Component */}
      <div class="max-w-2xl mx-auto">
        <SimpleSearch />
      </div>
    </div>
  </section>

{/* Professional Projects Grid */}
  <section class="py-16 md:py-24">
    <div class="container mx-auto px-6">
      <div class="grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-3 gap-8 max-w-7xl mx-auto">
{projeler.map((proje) => (
          <article class="group relative bg-slate-800/50 backdrop-blur-sm border border-slate-700/50 rounded-2xl overflow-hidden hover:border-purple-400/50 transition-all duration-500 hover:transform hover:scale-[1.02] hover:shadow-2xl hover:shadow-purple-500/10">
            {/* Make entire card clickable */}
            <a href={`/projeler/${proje.slug}/`} class="absolute inset-0 z-10" aria-label={`View project: ${proje.data.title}`}></a>
            
            {/* Professional Project Image */}
            {proje.data.image && (
              <div class="relative overflow-hidden">
                <img
                  src={proje.data.image.src}
                  alt={proje.data.image.alt}
                  loading="lazy"
                  class="w-full h-48 object-cover transition-transform duration-700 group-hover:scale-110"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-slate-900/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                
                {/* Category Badge */}
                <div class="absolute top-4 right-4 relative z-20">
                  <span class="px-3 py-1 bg-purple-600/90 backdrop-blur-sm text-white text-xs font-medium rounded-full">
                    Proje
                  </span>
                </div>
              </div>
            )}
            
            {/* Project Content */}
            <div class="p-6">
              {/* Project Meta */}
              <div class="flex items-center gap-4 mb-4">
                <div class="flex items-center text-gray-400 text-sm">
                  <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                  </svg>
                  {proje.data.publishDate.toLocaleDateString('tr-TR', { 
                    year: 'numeric', 
                    month: 'short', 
                    day: 'numeric' 
                  })}
                </div>
                <div class="flex items-center text-gray-400 text-sm">
                  <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                  </svg>
                  {proje.data.author}
                </div>
              </div>
              
              {/* Post Title */}
              <h2 class="text-xl font-bold mb-3 text-white group-hover:text-blue-300 transition-colors duration-300 line-clamp-2">
                {proje.data.title}
              </h2>
              
              {/* Post Description */}
              <p class="text-gray-400 mb-4 line-clamp-3 leading-relaxed">
                {proje.data.description}
              </p>
              
              {/* Tags */}
              {proje.data.tags && proje.data.tags.length > 0 && (
                <div class="flex flex-wrap gap-2 mb-4">
                  {proje.data.tags.slice(0, 3).map(tag => (
                    <span class="px-2 py-1 bg-slate-700/50 text-blue-300 text-xs rounded-md border border-slate-600/50 hover:bg-slate-600/50 transition-colors relative z-20">
                      {tag}
                    </span>
                  ))}
                  {proje.data.tags.length > 3 && (
                    <span class="px-2 py-1 text-gray-400 text-xs">
                      +{proje.data.tags.length - 3} more
                    </span>
                  )}
                </div>
              )}
              
              {/* Read More Link */}
              <div class="flex items-center justify-between">
                <div class="flex items-center text-blue-400 group-hover:text-blue-300 transition-colors">
                  <span class="text-sm font-medium">Devamını Oku</span>
                  <svg class="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                  </svg>
                </div>
                
                {/* Reading Time Estimate */}
                <div class="text-gray-500 text-xs">
                  {Math.ceil(proje.data.description.length / 200)} dk okuma
                </div>
              </div>
            </div>
          </article>
        ))}
{projeler.length === 0 && (
          <div class="col-span-full text-center py-20">
            <div class="mx-auto max-w-md">
              <svg class="w-16 h-16 mx-auto mb-6 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
              </svg>
              <h3 class="text-xl font-semibold text-gray-300 mb-2">Henüz Proje Yok</h3>
              <p class="text-gray-500">Projeler yayınlandıkça burada görüntülenecek.</p>
            </div>
          </div>
        )}
      </div>
    </div>
  </section>
</Layout>
