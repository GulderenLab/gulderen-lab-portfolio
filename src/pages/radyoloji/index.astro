---
// src/pages/radyoloji/index.astro
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const pageTitle = "Radyoloji";
const pageDescription = "Radyoloji üzerine içerikler ve kılavuzlar.";

// Radyoloji yazılarını al, taslak olmayan ları filtrele ve tarihe göre sırala
const posts = (await getCollection('radyoloji'))
    .filter(post => !post.data.isDraft)
    .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

// Kategorilere göre grupla
const postsByCategory = posts.reduce((acc, post) => {
  const category = post.data.category;
  if (!acc[category]) {
    acc[category] = [];
  }
  acc[category].push(post);
  return acc;
}, {});

// Kategori sırası (Fizik en üste)
const categoryOrder = [
  'Radyoloji Fiziği',
  'Klinik Rehberler',
  'Eğitim Serisi',
  'Gırışımsel Radyoloji',
  'Genel Radyoloji'
];

// Fizik postlarını ayrı olarak al
const physicsPosts = postsByCategory['Radyoloji Fiziği'] || [];
const otherPosts = posts.filter(post => post.data.category !== 'Radyoloji Fiziği');
---

<Layout title={pageTitle} description={pageDescription}>
  <!-- Radiology Header Section -->
  <section class="relative py-20 md:py-32 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-slate-900 via-blue-900/10 to-cyan-900/10"></div>
    <div class="absolute inset-0">
      <div class="absolute top-20 right-20 w-72 h-72 bg-blue-500/5 rounded-full blur-3xl"></div>
      <div class="absolute bottom-20 left-20 w-96 h-96 bg-cyan-500/5 rounded-full blur-3xl"></div>
    </div>
    
    <div class="relative container mx-auto px-6 text-center">
      <!-- Section Badge -->
      <div class="inline-flex items-center px-4 py-2 mb-8 bg-slate-800/50 backdrop-blur-sm border border-slate-700/50 rounded-full">
        <span class="text-sm text-blue-400 font-medium">Radyoloji Rehberi</span>
      </div>
      
      <h1 class="text-5xl md:text-6xl font-bold mb-6">
        <span class="bg-gradient-to-r from-white via-blue-100 to-cyan-100 bg-clip-text text-transparent">
          Radyoloji İçerikleri
        </span>
      </h1>
      
      <p class="text-xl text-gray-300 max-w-3xl mx-auto mb-12 leading-relaxed">
        Radyoloji alanındaki en son gelişmeler, <span class="text-cyan-300 font-semibold">klinik kılavuzlar</span> ve teknik detaylar.
      </p>
      
      <!-- Quick Access Buttons -->
      <div class="flex flex-col sm:flex-row justify-center gap-4">
        <a 
          href="/radyoloji/sinav-olusturucu"
          class="group inline-flex items-center px-8 py-4 bg-gradient-to-r from-purple-600 to-pink-600 hover:from-purple-500 hover:to-pink-500 text-white font-semibold rounded-xl transition-all duration-300 transform hover:scale-105 shadow-lg hover:shadow-xl"
        >
          <svg class="w-5 h-5 mr-3 group-hover:rotate-12 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
          </svg>
          Sınav Oluşturucu
        </a>
        
        <div class="relative group">
          <div class="absolute -inset-0.5 bg-gradient-to-r from-blue-600 to-cyan-600 rounded-xl blur opacity-30 group-hover:opacity-100 transition duration-1000 group-hover:duration-200"></div>
          <div class="relative inline-flex items-center px-8 py-4 bg-slate-900 border border-blue-500/20 hover:border-blue-400/50 text-blue-300 hover:text-white font-semibold rounded-xl transition-all duration-300">
            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
            Yakında: Hızlı Quiz
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Exam Creator Feature Section -->
  <section class="py-16 md:py-24 bg-gradient-to-br from-purple-900/10 to-pink-900/10">
    <div class="container mx-auto px-6">
      <div class="text-center mb-12">
        <div class="inline-flex items-center px-4 py-2 mb-6 bg-gradient-to-r from-purple-600 to-pink-600 rounded-full">
          <svg class="w-4 h-4 mr-2 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
          </svg>
          <span class="text-white text-sm font-medium">Sınav Sistemi</span>
        </div>
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">
          Özel Sınavlar Oluşturun
        </h2>
        <p class="text-gray-300 max-w-2xl mx-auto">
          Radyoloji konularından <span class="text-purple-300 font-semibold">kişiselleştirilmiş sınavlar</span> oluşturun ve bilginizi test edin
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-5xl mx-auto">
        <!-- Feature 1 -->
        <div class="text-center p-6 bg-gradient-to-br from-slate-800/30 to-slate-900/30 backdrop-blur-sm border border-purple-500/20 rounded-xl">
          <div class="w-12 h-12 mx-auto mb-4 bg-gradient-to-br from-purple-500 to-pink-500 rounded-lg flex items-center justify-center">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-white mb-2">Konu Seçimi</h3>
          <p class="text-gray-400 text-sm">X-ray, BT, MRG, Ultrason ve daha fazla konudan seçim yapın</p>
        </div>
        
        <!-- Feature 2 -->
        <div class="text-center p-6 bg-gradient-to-br from-slate-800/30 to-slate-900/30 backdrop-blur-sm border border-purple-500/20 rounded-xl">
          <div class="w-12 h-12 mx-auto mb-4 bg-gradient-to-br from-blue-500 to-cyan-500 rounded-lg flex items-center justify-center">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-white mb-2">Özelleştirme</h3>
          <p class="text-gray-400 text-sm">Soru sayısı, süre limiti ve karışık soru seçenekleri</p>
        </div>
        
        <!-- Feature 3 -->
        <div class="text-center p-6 bg-gradient-to-br from-slate-800/30 to-slate-900/30 backdrop-blur-sm border border-purple-500/20 rounded-xl">
          <div class="w-12 h-12 mx-auto mb-4 bg-gradient-to-br from-green-500 to-blue-500 rounded-lg flex items-center justify-center">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-white mb-2">Detaylı Sonuçlar</h3>
          <p class="text-gray-400 text-sm">Açıklamalı cevap inceleme ve performans analizi</p>
        </div>
      </div>
      
      <div class="text-center mt-12">
        <a 
          href="/radyoloji/sinav-olusturucu" 
          class="inline-flex items-center px-8 py-4 bg-gradient-to-r from-purple-600 to-pink-600 hover:from-purple-500 hover:to-pink-500 text-white font-semibold rounded-xl transition-all duration-300 transform hover:scale-105 shadow-lg hover:shadow-xl"
        >
          <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
          </svg>
          Hemen Sınav Oluştur
        </a>
      </div>
    </div>
  </section>

  <!-- Radyoloji Fiziği Highlight Section -->
  {physicsPosts.length > 0 && (
    <section class="py-16 md:py-24 bg-gradient-to-br from-purple-900/20 to-blue-900/20">
      <div class="container mx-auto px-6">
        <div class="text-center mb-16">
          <div class="inline-flex items-center px-4 py-2 mb-6 bg-gradient-to-r from-purple-600 to-blue-600 rounded-full">
            <span class="text-white text-sm font-medium mr-2">🔬</span>
            <span class="text-white text-sm font-medium">Radyoloji Fiziği</span>
          </div>
          <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">
            Fizik Temelleri
          </h2>
          <p class="text-gray-300 max-w-2xl mx-auto mb-8">
            Her modalite için <span class="text-purple-300 font-semibold">detaylı fizik prensipleri</span> ve klinik uygulamalar
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 max-w-4xl mx-auto">
          {physicsPosts.map((post) => (
            <article class="group relative bg-gradient-to-br from-slate-800/50 to-slate-900/50 backdrop-blur-sm border border-purple-500/20 rounded-2xl overflow-hidden hover:border-purple-400/50 transition-all duration-500 hover:transform hover:scale-[1.02] hover:shadow-2xl hover:shadow-purple-500/10">
              <a href={`/radyoloji/${post.slug}/`} class="absolute inset-0 z-10" aria-label={`Read: ${post.data.title}`}></a>
              
              <div class="p-6">
                <div class="flex items-center gap-4 mb-4">
                  <div class="flex items-center text-purple-400 text-sm font-medium">
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
                    </svg>
                    {post.data.category}
                  </div>
                  <div class="flex items-center text-gray-400 text-sm">
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    {post.data.readingTime || '25 dk okuma'}
                  </div>
                </div>
                <h3 class="text-xl font-bold mb-3 text-white group-hover:text-purple-300 transition-colors duration-300">
                  {post.data.title}
                </h3>
                <p class="text-gray-400 mb-4 leading-relaxed">
                  {post.data.description}
                </p>
                {post.data.tags && post.data.tags.length > 0 && (
                  <div class="flex flex-wrap gap-2 mb-4">
                    {post.data.tags.slice(0, 4).map(tag => (
                      <span class="px-2 py-1 bg-purple-500/20 text-purple-300 text-xs rounded-md border border-purple-500/30 hover:bg-purple-500/30 transition-colors relative z-20">
                        #{tag}
                      </span>
                    ))}
                  </div>
                )}
                <div class="flex items-center justify-between">
                  <div class="flex items-center text-purple-400 group-hover:text-purple-300 transition-colors">
                    <span class="text-sm font-medium">Fizik Rehberini İncele</span>
                    <svg class="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
                    </svg>
                  </div>
                  <div class="bg-gradient-to-r from-purple-500/20 to-blue-500/20 px-3 py-1 rounded-full">
                    <span class="text-purple-300 text-xs font-medium">🔬 Fizik</span>
                  </div>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Other Radiology Content -->
  <section class="py-16 md:py-24">
    <div class="container mx-auto px-6">
      {otherPosts.length > 0 && (
        <div class="text-center mb-16">
          <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">
            Klinik İçerikler
          </h2>
          <p class="text-gray-400 max-w-2xl mx-auto">
            Klinik uygulamalar, rehberler ve eğitim materyalleri
          </p>
        </div>
      )}
      
      <div class="grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-3 gap-8 max-w-7xl mx-auto">
        {otherPosts.map((post) => (
          <article class="group relative bg-slate-800/50 backdrop-blur-sm border border-slate-700/50 rounded-2xl overflow-hidden hover:border-blue-400/50 transition-all duration-500 hover:transform hover:scale-[1.02] hover:shadow-2xl hover:shadow-blue-500/10">
            <a href={`/radyoloji/${post.slug}/`} class="absolute inset-0 z-10" aria-label={`Read: ${post.data.title}`}></a>
            
            <div class="p-6">
              <div class="flex items-center gap-4 mb-4">
                <div class="flex items-center text-gray-400 text-sm">
                  <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                  </svg>
                  {post.data.category}
                </div>
                <div class="flex items-center text-gray-400 text-sm">
                  <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                  </svg>
                  {post.data.publishDate.toLocaleDateString('tr-TR', { 
                    year: 'numeric', 
                    month: 'short', 
                    day: 'numeric' 
                  })}
                </div>
              </div>
              <h3 class="text-xl font-bold mb-3 text-white group-hover:text-blue-300 transition-colors duration-300">
                {post.data.title}
              </h3>
              <p class="text-gray-400 mb-4 leading-relaxed">
                {post.data.description}
              </p>
              {post.data.tags && post.data.tags.length > 0 && (
                <div class="flex flex-wrap gap-2 mb-4">
                  {post.data.tags.slice(0, 3).map(tag => (
                    <span class="px-2 py-1 bg-slate-700/50 text-blue-300 text-xs rounded-md border border-slate-600/50 hover:bg-slate-600/50 transition-colors relative z-20">
                      {tag}
                    </span>
                  ))}
                  {post.data.tags.length > 3 && (
                    <span class="px-2 py-1 text-gray-400 text-xs">
                      +{post.data.tags.length - 3} more
                    </span>
                  )}
                </div>
              )}
              <div class="flex items-center justify-between">
                <div class="flex items-center text-blue-400 group-hover:text-blue-300 transition-colors">
                  <span class="text-sm font-medium">Detayları Görüntüle</span>
                  <svg class="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
                  </svg>
                </div>
                <div class="text-gray-500 text-xs">
                  {post.data.readingTime || '5 dk okuma'}
                </div>
              </div>
            </div>
          </article>
        ))}
        
        {posts.length === 0 && (
          <div class="col-span-full text-center py-20">
            <div class="mx-auto max-w-md">
              <svg class="w-16 h-16 mx-auto mb-6 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
              </svg>
              <h3 class="text-xl font-semibold text-gray-300 mb-2">Henüz İçerik Yok</h3>
              <p class="text-gray-500">Radyoloji içerikleri yayınlandıkça burada görüntülenecek.</p>
            </div>
          </div>
        )}
      </div>
    </div>
  </section>
</Layout>

