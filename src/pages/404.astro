---
// src/pages/404.astro
import Layout from '../layouts/Layout.astro';
---

<Layout title="Sayfa bulunamadı" description="Aradığınız sayfa taşınmış ya da kaldırılmış olabilir." noindex>
  <section class="not-prose min-h-[60vh] flex flex-col items-center justify-center text-center px-4">
    <p class="text-7xl font-bold bg-linear-to-r from-blue-400 to-cyan-300 bg-clip-text text-transparent">404</p>
    <h1 class="mt-4 text-3xl font-bold text-white">Sayfa bulunamadı</h1>
    <p class="mt-3 max-w-xl text-gray-400">Aradığınız sayfa taşınmış ya da kaldırılmış olabilir. Arama yapmayı ya da aşağıdaki bağlantıları deneyin.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="px-5 py-2.5 rounded-lg bg-linear-to-r from-blue-600 to-cyan-600 text-white font-semibold">Ana Sayfa</a>
      <a href="/ara/" class="px-5 py-2.5 rounded-lg border border-slate-600 text-gray-200 hover:border-cyan-400">Sitede Ara</a>
      <a href="/blog/" class="px-5 py-2.5 rounded-lg border border-slate-600 text-gray-200 hover:border-cyan-400">Blog</a>
      <a href="/projeler/" class="px-5 py-2.5 rounded-lg border border-slate-600 text-gray-200 hover:border-cyan-400">Projeler</a>
    </div>
  </section>
</Layout>
