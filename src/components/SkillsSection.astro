        </div>
        
        <div class="tech-icon flex flex-col items-center p-4 rounded-lg hover:bg-slate-700/30 transition-all duration-300 group">
          <div class="w-12 h-12 bg-gradient-to-br from-blue-500 to-blue-600 rounded-lg flex items-center justify-center mb-2 group-hover:scale-110 transition-transform">
            <span class="text-white font-bold text-lg">TS</span>
          </div>
          <span class="text-gray-400 text-xs">TypeScript</span>
        </div>
        
        <div class="tech-icon flex flex-col items-center p-4 rounded-lg hover:bg-slate-700/30 transition-all duration-300 group">
          <div class="w-12 h-12 bg-gradient-to-br from-cyan-500 to-blue-500 rounded-lg flex items-center justify-center mb-2 group-hover:scale-110 transition-transform">
            <span class="text-white font-bold text-lg">R</span>
          </div>
          <span class="text-gray-400 text-xs">React</span>
        </div>
        
        <div class="tech-icon flex flex-col items-center p-4 rounded-lg hover:bg-slate-700/30 transition-all duration-300 group">
