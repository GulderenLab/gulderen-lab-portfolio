        </div>
        
        <div class="tech-icon flex flex-col items-center p-4 rounded-lg hover:bg-slate-700/30 transition-all duration-300 group">
          <div class="w-12 h-12 bg-gradient-to-br from-yellow-500 to-orange-500 rounded-lg flex items-center justify-center mb-2 group-hover:scale-110 transition-transform">
            <span class="text-white font-bold text-lg">P</span>
          </div>
          <span class="text-gray-400 text-xs">Python</span>
        </div>
        
        <div class="tech-icon flex flex-col items-center p-4 rounded-lg hover:bg-slate-700/30 transition-all duration-300 group">
          <div class="w-12 h-12 bg-gradient-to-br from-blue-600 to-purple-600 rounded-lg flex items-center justify-center mb-2 group-hover:scale-110 transition-transform">
            <span class="text-white font-bold text-lg">C++</span>
          </div>
          <span class="text-gray-400 text-xs">C++</span>
        </div>
        
