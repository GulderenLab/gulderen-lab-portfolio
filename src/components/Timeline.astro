---
// src/components/Timeline.astro
// Interactive timeline showing professional journey and milestones
---

<section class="py-20">
  <div class="max-w-4xl mx-auto px-4">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <h2 class="text-4xl font-bold text-white mb-4">
        Yolculuğum
      </h2>
      <p class="text-xl text-gray-400 max-w-2xl mx-auto">
        Teknoloji dünyasındaki serüvenimin önemli dönüm noktaları
      </p>
    </div>

    <!-- Timeline Container -->
    <div class="relative">
      <!-- Central Line -->
      <div class="absolute left-1/2 transform -translate-x-1/2 w-1 h-full bg-gradient-to-b from-blue-500 via-cyan-500 to-purple-500 rounded-full"></div>

      <!-- Timeline Items -->
      <div class="space-y-12">
        <!-- Timeline Item 1 -->
        <div class="timeline-item relative flex items-center" data-aos="fade-up">
          <div class="flex-1 pr-8 text-right">
            <div class="bg-gradient-to-br from-slate-800/50 to-slate-900/50 backdrop-blur-sm border border-slate-700/50 rounded-2xl p-6 hover:transform hover:scale-105 transition-all duration-300">
              <div class="flex items-center justify-end mb-3">
                <h3 class="text-xl font-semibold text-white mr-3">Elektronik Mühendisliği</h3>
                <div class="w-10 h-10 bg-gradient-to-br from-blue-500 to-cyan-500 rounded-lg flex items-center justify-center">
                  <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"/>
                  </svg>
                </div>
              </div>
              <span class="inline-block bg-blue-900/30 text-blue-300 text-sm px-3 py-1 rounded-full mb-3">2018 - 2023</span>
              <p class="text-gray-400 leading-relaxed">
                Üniversite eğitimim boyunca analog/dijital elektronik, gömülü sistemler ve sinyal işleme konularında derinlemesine bilgi edindim. Bu süreçte teorik bilgiyi pratiğe dökme konusunda kendimi geliştirdim.
              </p>
            </div>
          </div>
          
          <!-- Center Circle -->
          <div class="relative z-10 w-4 h-4 bg-gradient-to-r from-blue-500 to-cyan-500 rounded-full border-4 border-slate-900 timeline-dot"></div>
          
          <div class="flex-1 pl-8"></div>
        </div>

        <!-- Timeline Item 2 -->
        <div class="timeline-item relative flex items-center" data-aos="fade-up" data-aos-delay="200">
          <div class="flex-1 pr-8"></div>
          
          <!-- Center Circle -->
          <div class="relative z-10 w-4 h-4 bg-gradient-to-r from-green-500 to-emerald-500 rounded-full border-4 border-slate-900 timeline-dot"></div>
          
          <div class="flex-1 pl-8">
            <div class="bg-gradient-to-br from-slate-800/50 to-slate-900/50 backdrop-blur-sm border border-slate-700/50 rounded-2xl p-6 hover:transform hover:scale-105 transition-all duration-300">
              <div class="flex items-center mb-3">
                <div class="w-10 h-10 bg-gradient-to-br from-green-500 to-emerald-500 rounded-lg flex items-center justify-center mr-3">
                  <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/>
                  </svg>
                </div>
                <h3 class="text-xl font-semibold text-white">İlk Projeler</h3>
              </div>
              <span class="inline-block bg-green-900/30 text-green-300 text-sm px-3 py-1 rounded-full mb-3">2019 - 2021</span>
              <p class="text-gray-400 leading-relaxed">
                Arduino ve Raspberry Pi ile ilk projelerimi geliştirmeye başladım. IoT sensör ağları, otomatik sulama sistemleri ve basit robotik projeler bu dönemin başlıca çalışmalarıydı.
              </p>
            </div>
          </div>
        </div>

        <!-- Timeline Item 3 -->
        <div class="timeline-item relative flex items-center" data-aos="fade-up" data-aos-delay="400">
          <div class="flex-1 pr-8 text-right">
            <div class="bg-gradient-to-br from-slate-800/50 to-slate-900/50 backdrop-blur-sm border border-slate-700/50 rounded-2xl p-6 hover:transform hover:scale-105 transition-all duration-300">
              <div class="flex items-center justify-end mb-3">
                <h3 class="text-xl font-semibold text-white mr-3">Web Geliştirme Keşfi</h3>
                <div class="w-10 h-10 bg-gradient-to-br from-purple-500 to-pink-500 rounded-lg flex items-center justify-center">
                  <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>
                  </svg>
                </div>
              </div>
              <span class="inline-block bg-purple-900/30 text-purple-300 text-sm px-3 py-1 rounded-full mb-3">2021 - 2022</span>
              <p class="text-gray-400 leading-relaxed">
                JavaScript ve React öğrenmeye başladım. Bu dönemde web teknolojilerinin gücünü keşfederek, elektronik projelerimi web arayüzleri ile buluşturdum. İlk full-stack projelerimi geliştirdim.
              </p>
            </div>
          </div>
          
          <!-- Center Circle -->
          <div class="relative z-10 w-4 h-4 bg-gradient-to-r from-purple-500 to-pink-500 rounded-full border-4 border-slate-900 timeline-dot"></div>
          
          <div class="flex-1 pl-8"></div>
        </div>

        <!-- Timeline Item 4 -->
        <div class="timeline-item relative flex items-center" data-aos="fade-up" data-aos-delay="600">
          <div class="flex-1 pr-8"></div>
          
          <!-- Center Circle -->
          <div class="relative z-10 w-4 h-4 bg-gradient-to-r from-orange-500 to-red-500 rounded-full border-4 border-slate-900 timeline-dot"></div>
          
          <div class="flex-1 pl-8">
            <div class="bg-gradient-to-br from-slate-800/50 to-slate-900/50 backdrop-blur-sm border border-slate-700/50 rounded-2xl p-6 hover:transform hover:scale-105 transition-all duration-300">
              <div class="flex items-center mb-3">
                <div class="w-10 h-10 bg-gradient-to-br from-orange-500 to-red-500 rounded-lg flex items-center justify-center mr-3">
                  <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
                  </svg>
                </div>
                <h3 class="text-xl font-semibold text-white">CAD Query & 3D Tasarım</h3>
              </div>
              <span class="inline-block bg-orange-900/30 text-orange-300 text-sm px-3 py-1 rounded-full mb-3">2022 - 2023</span>
              <p class="text-gray-400 leading-relaxed">
                CAD Query ile parametrik 3D modelleme dünyasına adım attım. Python ile mekanik parça tasarımı yaparak, elektronik projelerime özel kutular ve mekanik bileşenler üretmeye başladım.
              </p>
            </div>
          </div>
        </div>

        <!-- Timeline Item 5 - Current -->
        <div class="timeline-item relative flex items-center" data-aos="fade-up" data-aos-delay="800">
          <div class="flex-1 pr-8 text-right">
            <div class="bg-gradient-to-br from-slate-800/50 to-slate-900/50 backdrop-blur-sm border border-slate-700/50 rounded-2xl p-6 hover:transform hover:scale-105 transition-all duration-300 border-cyan-500/50">
              <div class="flex items-center justify-end mb-3">
                <h3 class="text-xl font-semibold text-white mr-3">Gulderen Lab</h3>
                <div class="w-10 h-10 bg-gradient-to-br from-cyan-500 to-blue-500 rounded-lg flex items-center justify-center">
                  <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                  </svg>
                </div>
              </div>
              <div class="flex items-center justify-end mb-3">
                <span class="inline-block bg-cyan-900/30 text-cyan-300 text-sm px-3 py-1 rounded-full mr-2">2024 - Şimdi</span>
                <span class="inline-flex items-center space-x-1 bg-green-900/30 text-green-300 text-xs px-2 py-1 rounded-full">
                  <div class="w-2 h-2 bg-green-400 rounded-full animate-pulse"></div>
                  <span>Aktif</span>
                </span>
              </div>
              <p class="text-gray-400 leading-relaxed">
                Tüm deneyimlerimi birleştirerek Gulderen Lab'ı kurdum. Modern web teknolojileri, elektronik tasarım ve 3D modelleme alanlarındaki projelerimi ve bilgilerimi paylaştığım bu platform ile toplulukla buluşuyorum.
              </p>
            </div>
          </div>
          
          <!-- Center Circle - Glowing -->
          <div class="relative z-10 w-6 h-6 bg-gradient-to-r from-cyan-500 to-blue-500 rounded-full border-4 border-slate-900 timeline-dot-current">
            <div class="absolute inset-0 bg-gradient-to-r from-cyan-500 to-blue-500 rounded-full animate-ping"></div>
          </div>
          
          <div class="flex-1 pl-8"></div>
        </div>
      </div>
    </div>

    <!-- Future Goals -->
    <div class="mt-20 text-center">
      <div class="bg-gradient-to-br from-slate-800/30 to-slate-900/30 backdrop-blur-sm border border-slate-700/50 rounded-2xl p-8">
        <h3 class="text-2xl font-bold text-white mb-4">Gelecek Hedeflerim</h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="space-y-2">
            <div class="w-12 h-12 bg-gradient-to-br from-blue-500 to-cyan-500 rounded-lg flex items-center justify-center mx-auto">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
            </div>
            <h4 class="text-white font-semibold">Open Source</h4>
            <p class="text-gray-400 text-sm">Daha fazla açık kaynak projesi geliştirmek</p>
          </div>
          <div class="space-y-2">
            <div class="w-12 h-12 bg-gradient-to-br from-green-500 to-emerald-500 rounded-lg flex items-center justify-center mx-auto">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z"/>
              </svg>
            </div>
            <h4 class="text-white font-semibold">Topluluk</h4>
            <p class="text-gray-400 text-sm">Teknik toplulukla daha fazla etkileşim</p>
          </div>
          <div class="space-y-2">
            <div class="w-12 h-12 bg-gradient-to-br from-purple-500 to-pink-500 rounded-lg flex items-center justify-center mx-auto">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
              </svg>
            </div>
            <h4 class="text-white font-semibold">İnovasyon</h4>
            <p class="text-gray-400 text-sm">Yenilikçi teknoloji çözümleri üretmek</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // Simple scroll animation for timeline items
  const observerOptions = {
    threshold: 0.3,
    rootMargin: '0px 0px -50px 0px'
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.style.opacity = '1';
        entry.target.style.transform = 'translateY(0)';
      }
    });
  }, observerOptions);

  document.querySelectorAll('.timeline-item').forEach((item, index) => {
    item.style.opacity = '0';
    item.style.transform = 'translateY(50px)';
    item.style.transition = `opacity 0.6s ease-out ${index * 0.2}s, transform 0.6s ease-out ${index * 0.2}s`;
    observer.observe(item);
  });
});
</script>

<style>
  .timeline-dot {
    animation: pulse-dot 2s infinite;
  }
  
  .timeline-dot-current {
    animation: pulse-current 2s infinite;
  }
  
  @keyframes pulse-dot {
    0%, 100% {
      box-shadow: 0 0 0 0 rgba(59, 130, 246, 0.4);
    }
    50% {
      box-shadow: 0 0 0 8px rgba(59, 130, 246, 0);
    }
  }
  
  @keyframes pulse-current {
    0%, 100% {
      box-shadow: 0 0 0 0 rgba(6, 182, 212, 0.6);
    }
    50% {
      box-shadow: 0 0 0 12px rgba(6, 182, 212, 0);
    }
  }
</style>
