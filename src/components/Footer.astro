---
// src/components/Footer.astro
const today = new Date();

// Social media links with icons
const socialLinks = [
  {
    href: 'https://github.com/GulderenLab',
    text: 'GitHub',
    icon: 'github',
    color: 'hover:text-gray-300'
  },
  {
    href: 'https://linkedin.com/in/abdullah-gülderen-31120b35b/',
    text: 'LinkedIn',
    icon: 'linkedin',
    color: 'hover:text-blue-400'
  },
  {
    href: 'mailto:contact@gulderenlab.com',
    text: 'Email',
    icon: 'email',
    color: 'hover:text-green-400'
  }
];

// Footer navigation links
const footerNavLinks = [
  { href: '/projeler', text: 'Projeler' },
  { href: '/blog', text: 'Blog' },
  { href: '/hesaplama-araclari', text: 'Araçlar' },
  { href: '/hakkimizda', text: 'Hakkımızda' },
  { href: '/iletisim', text: 'İletişim' },
  { href: '/gizlilik-politikasi', text: 'Gizlilik' }
];

// Quick stats
const stats = [
  { label: 'Projeler', value: '15+' },
  { label: 'Blog Yazıları', value: '25+' },
  { label: 'Teknoloji', value: '10+' }
];
---

<footer class="mt-auto bg-gradient-to-t from-slate-900 to-slate-800 border-t border-slate-700/50 relative overflow-hidden">
  {/* Background decoration */}
  <div class="absolute inset-0 bg-gradient-to-r from-blue-600/5 to-cyan-600/5"></div>
  <div class="absolute top-0 left-1/4 w-96 h-96 bg-blue-500/5 rounded-full blur-3xl"></div>
  <div class="absolute bottom-0 right-1/4 w-96 h-96 bg-cyan-500/5 rounded-full blur-3xl"></div>
  
  <div class="relative container mx-auto px-6 py-12">
    {/* Main Footer Content */}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 mb-8">
      
      {/* Brand Section */}
      <div class="lg:col-span-2">
        <div class="flex items-center space-x-3 mb-4">
          <div class="w-10 h-10 bg-gradient-to-br from-blue-500 to-cyan-400 rounded-lg flex items-center justify-center">
            <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
            </svg>
          </div>
          <h3 class="text-2xl font-bold bg-gradient-to-r from-blue-400 to-cyan-300 bg-clip-text text-transparent">
            Gulderen Lab
          </h3>
        </div>
        <p class="text-gray-400 mb-6 max-w-md leading-relaxed">
          Elektronik, yazılım geliştirme ve yenilikçi teknolojiler alanında uzmanlaşmış bir mühendislik laboratuvarı. 
          Geleceğin teknolojilerini bugünden kodluyoruz.
        </p>
        
        {/* Quick Stats */}
        <div class="flex space-x-6">
          {stats.map(stat => (
            <div class="text-center">
              <div class="text-xl font-bold text-cyan-400">{stat.value}</div>
              <div class="text-xs text-gray-500">{stat.label}</div>
            </div>
          ))}
        </div>
      </div>
      
      {/* Quick Links */}
      <div>
        <h4 class="text-lg font-semibold text-white mb-4">Hızlı Erişim</h4>
        <nav class="space-y-2">
          {footerNavLinks.map(link => (
            <a 
              href={link.href} 
              class="block text-gray-400 hover:text-cyan-300 transition-colors duration-300 text-sm"
            >
              {link.text}
            </a>
          ))}
        </nav>
      </div>
      
      {/* Contact & Social */}
      <div>
        <h4 class="text-lg font-semibold text-white mb-4">Bağlantı</h4>
        <div class="space-y-3">
          {socialLinks.map(social => (
            <a 
              href={social.href}
              target={social.href.startsWith('http') ? '_blank' : undefined}
              rel={social.href.startsWith('http') ? 'noopener noreferrer' : undefined}
              class={`flex items-center space-x-3 text-gray-400 ${social.color} transition-colors duration-300 group`}
            >
              {/* Social Icons */}
              {social.icon === 'github' && (
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                </svg>
              )}
              {social.icon === 'linkedin' && (
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                </svg>
              )}
              {social.icon === 'email' && (
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              )}
              <span class="text-sm group-hover:translate-x-1 transition-transform duration-300">
                {social.text}
              </span>
            </a>
          ))}
        </div>
        
        {/* Newsletter Signup */}
        <div class="mt-6 p-4 bg-slate-800/50 rounded-lg border border-slate-700/50">
          <h5 class="text-sm font-medium text-white mb-2">Güncellemeler</h5>
          <p class="text-xs text-gray-400 mb-3">Yeni projeler ve yazılar hakkında bilgi alın</p>
          <div class="flex">
            {/* Netlify Forms uyumlu form (AJAX submit ile sayfa zıplamasını önler) */}
            <form 
              id="nl-form"
              name="newsletter" 
              method="POST" 
              data-netlify="true"
              data-netlify-honeypot="bot-field"
              class="flex w-full"
              onsubmit="return window.__nlHandle && window.__nlHandle(event);"
            >
              <input type="hidden" name="form-name" value="newsletter" />
              <p class="hidden">
                <label>Don’t fill this out if you’re human: <input name="bot-field" /></label>
              </p>
              <input 
                id="nl-email"
                name="email"
                type="email" 
                required
                placeholder="E-posta adresiniz"
                class="flex-1 px-3 py-2 bg-slate-700/50 border border-slate-600 rounded-l-md text-sm text-white placeholder-gray-400 focus:outline-none focus:border-cyan-400"
              >
              <button id="nl-submit" type="submit" class="px-4 py-2 bg-gradient-to-r from-blue-600 to-cyan-600 hover:from-blue-500 hover:to-cyan-500 rounded-r-md text-white text-sm font-medium transition-all duration-300">
                Abone Ol
              </button>
            </form>
          </div>
          <p id="nl-status" class="sr-only" aria-live="polite"></p>
        </div>
      </div>
    </div>
    
    {/* Bottom Bar */}
    <div class="pt-8 border-t border-slate-700/50">
      <div class="flex flex-col md:flex-row justify-between items-center gap-4">
        <div class="flex items-center space-x-4 text-sm text-gray-400">
          <span>© {today.getFullYear()} Gulderen Lab. Tüm hakları saklıdır.</span>
          <span class="hidden md:inline">•</span>
          <span class="text-xs">Türkiye'den ❤️ ile yapıldı</span>
        </div>
        
        <div class="flex items-center space-x-4 text-xs text-gray-500">
          <span>v2.1.0</span>
          <span>•</span>
          <span>Son güncelleme: {today.toLocaleDateString('tr-TR')}</span>
          <span>•</span>
          <a href="/sitemap.xml" class="hover:text-cyan-400 transition-colors">Sitemap</a>
        </div>
      </div>
    </div>
  </div>
</footer>

<script is:inline>
// Netlify Forms AJAX submit: Sayfa yenilemesini ve yukarı zıplamayı engeller,
// yine de Netlify Forms tarafından işlenir.
window.encodeForm = function(data) {
  return Object.keys(data)
    .map((key) => encodeURIComponent(key) + '=' + encodeURIComponent(data[key]))
    .join('&');
};

window.__nlHandle = function(e) {
  if (!e) return false;
  e.preventDefault();
  e.stopPropagation();

  var form = document.getElementById('nl-form');
  var emailInput = document.getElementById('nl-email');
  var submitBtn = document.getElementById('nl-submit');
  var statusEl = document.getElementById('nl-status');
  var email = (emailInput && emailInput.value) ? emailInput.value : '';

  if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
    if (statusEl) {
      statusEl.classList.remove('sr-only');
      statusEl.textContent = 'Lütfen geçerli bir e-posta girin.';
    }
    return false;
  }

  if (submitBtn) {
    submitBtn.disabled = true;
    submitBtn.textContent = 'Gönderiliyor...';
  }

  fetch('/', {
    method: 'POST',
    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
    body: window.encodeForm({
      'form-name': 'newsletter',
      email: email
    })
  })
    .then(function() {
      if (statusEl) {
        statusEl.classList.remove('sr-only');
        statusEl.textContent = 'Abonelik başarılı! Teşekkürler.';
      }
      if (form && form.reset) form.reset();
    })
    .catch(function() {
      if (statusEl) {
        statusEl.classList.remove('sr-only');
        statusEl.textContent = 'Bir hata oluştu. Lütfen tekrar deneyin.';
      }
    })
    .finally(function() {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Abone Ol';
      }
    });

  return false;
};
</script>
