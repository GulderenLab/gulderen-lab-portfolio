---
// src/components/TableOfContents.astro — Açılır/kapanır içindekiler tablosu (h2–h3)
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
  maxDepth?: number;
}

const { headings, maxDepth = 3 } = Astro.props;
const displayHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= maxDepth);
const shouldShowToc = displayHeadings.length > 1;
---

{shouldShowToc && (
  <nav class="toc mb-8 rounded-lg border border-slate-700/70 bg-slate-800/40" aria-label="İçindekiler">
    <details open={displayHeadings.length <= 12}>
      <summary class="cursor-pointer select-none px-4 py-3 text-lg font-semibold text-gray-100">
        İçindekiler <span class="text-sm font-normal text-gray-400">({displayHeadings.length} başlık)</span>
      </summary>
      <ul class="px-4 pb-4 space-y-1.5">
        {displayHeadings.map((heading) => (
          <li class={`toc-depth-${heading.depth}`}>
            <a href={`#${heading.slug}`} class="block text-brand hover:text-accent-light hover:underline transition-colors duration-150">
              {heading.text}
            </a>
          </li>
        ))}
      </ul>
    </details>
  </nav>
)}

<style>
  .toc ul { list-style: none; margin: 0; }
  .toc li { list-style: none; margin: 0; padding-left: 0; }
  .toc li::marker, .toc li::before { content: none; }
  .toc li.toc-depth-3 { padding-left: 1rem; font-size: 0.95em; }
  .toc summary::-webkit-details-marker { color: var(--color-cyan-400); }
</style>
